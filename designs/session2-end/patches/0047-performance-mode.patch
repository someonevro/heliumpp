 }  // namespace
 
+namespace {
+constexpr char kPerfPref[] = "helium.performance_mode";
+constexpr char kPerfSavedPref[] = "helium.performance_saved";
+// How long a background tab stays loaded in performance mode.
+constexpr int kPerfDiscardMinutes = 5;
+}  // namespace
+
 void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterStringPref(kModePref, std::string());
+  registry->RegisterBooleanPref(kPerfPref, false);
+  registry->RegisterDictionaryPref(kPerfSavedPref);
+}
+
+bool IsPerformanceMode(Profile* profile) {
+  return profile->GetPrefs()->GetBoolean(kPerfPref);
+}
+
+void SetPerformanceMode(Profile* profile, bool enabled) {
+  namespace tuning = performance_manager::user_tuning::prefs;
+  PrefService* prefs = profile->GetPrefs();
+  // These are browser-wide (local state) prefs.
+  PrefService* local = g_browser_process->local_state();
+  if (enabled == prefs->GetBoolean(kPerfPref)) {
+    return;
+  }
+  if (enabled) {
+    base::DictValue saved;
+    saved.Set("mem_state", local->GetInteger(tuning::kMemorySaverModeState));
+    saved.Set("mem_aggr",
+              local->GetInteger(tuning::kMemorySaverModeAggressiveness));
+    saved.Set("mem_min", local->GetInteger(
+                             tuning::kMemorySaverModeTimeBeforeDiscardInMinutes));
+    saved.Set("battery", local->GetInteger(tuning::kBatterySaverModeState));
+    prefs->SetDict(kPerfSavedPref, std::move(saved));
+
+    local->SetInteger(tuning::kMemorySaverModeState,
+                      static_cast<int>(tuning::MemorySaverModeState::kEnabled));
+    local->SetInteger(
+        tuning::kMemorySaverModeAggressiveness,
+        static_cast<int>(tuning::MemorySaverModeAggressiveness::kAggressive));
+    local->SetInteger(tuning::kMemorySaverModeTimeBeforeDiscardInMinutes,
+                      kPerfDiscardMinutes);
+    local->SetInteger(tuning::kBatterySaverModeState,
+                      static_cast<int>(tuning::BatterySaverModeState::kEnabled));
+  } else {
+    const base::DictValue& saved = prefs->GetDict(kPerfSavedPref);
+    if (auto v = saved.FindInt("mem_state")) {
+      local->SetInteger(tuning::kMemorySaverModeState, *v);
+    }
+    if (auto v = saved.FindInt("mem_aggr")) {
+      local->SetInteger(tuning::kMemorySaverModeAggressiveness, *v);
+    }
+    if (auto v = saved.FindInt("mem_min")) {
+      local->SetInteger(tuning::kMemorySaverModeTimeBeforeDiscardInMinutes, *v);
+    }
+    if (auto v = saved.FindInt("battery")) {
+      local->SetInteger(tuning::kBatterySaverModeState, *v);
+    }
+    prefs->ClearPref(kPerfSavedPref);
+  }
+  prefs->SetBoolean(kPerfPref, enabled);
 }
 
