 bool ContentLiveTab::IsInitialBlankNavigation() {
+  // Helium: a tab with a private (isolated) storage area is reported as blank
+  // so it never lands in the "recently closed" list (or its file on disk).
+  content::WebContents* contents = &GetWebContents();
+  content::SiteInstance* site_instance = contents->GetSiteInstance();
+  if (site_instance && contents->GetBrowserContext()
+                               ->GetStoragePartition(site_instance)
+                               ->GetConfig()
+                               .partition_domain() == "heliumisolated") {
+    return true;
+  }
   return navigation_controller().IsInitialBlankNavigation();
 }
 
