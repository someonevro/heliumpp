+  protected onSearchSubmit_(e: Event) {
+    e.preventDefault();
+    const input = this.shadowRoot.querySelector<HTMLInputElement>(
+        '#searchInput')!;
+    const text = input.value.trim();
+    if (!text) {
+      return;
+    }
+    // Looks like an address: a scheme, or a dotted host without spaces.
+    const hasScheme = /^[a-z][a-z0-9+.-]*:\/\//i.test(text);
+    const looksLikeHost = !/\s/.test(text) && /^[^\s.]+\.[^\s.]{2,}(\/.*)?$/.test(text);
+    let target = '';
+    if (hasScheme && /^https?:/i.test(text)) {
+      target = text;
+    } else if (looksLikeHost) {
+      target = `https://${text}`;
+    } else {
+      const template = loadTimeData.getString('defaultSearchUrlTemplate');
+      if (!template) {
+        return;
+      }
+      target = template.replace('__QUERY__', encodeURIComponent(text));
+    }
+    window.location.href = target;
+  }
