+        transition: border-color 0.15s, background 0.15s;
+    }
+
+    .mode-card:hover {
+        background: var(--helium-elevated-7);
+    }
+
+    .mode-card:focus-visible {
+        outline: 2px solid var(--helium-blue);
+        outline-offset: 2px;
+    }
+
+    .mode-card.selected {
