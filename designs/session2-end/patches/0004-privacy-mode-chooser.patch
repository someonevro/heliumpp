+<script lang="ts">
+    import { HeliumLogo } from "@imput/helium-prism";
+    import { currentPage, selectedPrivacyMode } from "../lib/onboarding-flow";
+    import presets from "../lib/presets.json";
+
+    import PageHeader from "../components/PageHeader.svelte";
+
+    type Setting = { label: string; effects: Record<string, string> };
+
+    const settings: Record<string, Setting> = presets.settings;
+    const modes: Record<string, Record<string, unknown>> = presets.presets;
+    const meta: Record<string, { name: string; tagline: string; tradeoff: string }> = presets.meta;
+
+    const visible = $derived($currentPage === "PrivacyMode");
+    const selected = $derived($selectedPrivacyMode);
+    // Only settings that have text are shown; optional telemetry is "off" in every mode.
+    const details = $derived(
+        Object.entries(modes[selected]).map(([key, value]) => ({
+            key,
+            label: settings[key].label,
+            effect: settings[key].effects[JSON.stringify(value)],
+        })).filter(item => item.effect)
+    );
+</script>
+
+<div id="privacy-mode-page" class="onboarding-page" class:visible>
+    <div class="scrollable-page">
+        <PageHeader
+            title="Choose your privacy level"
+            subtitle="uBlock Origin ad blocking is on in every mode. You can change this later."
+            Icon={HeliumLogo}
+            iconHeight="32px"
+        />
+        <div class="page-content">
+            <div class="mode-list" role="radiogroup" aria-label="Privacy level">
+                {#each presets.order as id (id)}
+                    <button
+                        type="button"
+                        role="radio"
+                        aria-checked={selected === id}
+                        class="mode-card"
+                        class:selected={selected === id}
+                        onclick={() => selectedPrivacyMode.set(id)}
+                    >
+                        <span class="mode-name">
+                            {meta[id].name}
+                            {#if id === presets.recommended}
+                                <span class="badge">Recommended</span>
+                            {/if}
+                        </span>
+                        <span class="mode-tagline">{meta[id].tagline}</span>
+                        <span class="mode-tradeoff">{meta[id].tradeoff}</span>
+                    </button>
+                {/each}
+            </div>
+
+            <div class="details" aria-live="polite">
+                <h3>What {meta[selected].name} does</h3>
+                <ul>
+                    {#each details as item (item.key)}
+                        <li>
+                            <strong>{item.label}</strong>
+                            <span>{item.effect}</span>
+                        </li>
+                    {/each}
+                </ul>
+                <p class="note">{presets.note}</p>
+            </div>
+        </div>
+    </div>
+</div>
+
+<style>
+    #privacy-mode-page {
+        --page-in-delay: 0.1s;
