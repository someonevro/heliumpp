+void OnboardingMessageHandler::HandleSetTabLayout(
+    const base::ListValue& args) {
+  if (args.size() != 2 || !args[0].is_string()) {
+    return;
+  }
+
+  AllowJavascript();
+
+  const auto& callback_id = args[0].GetString();
+  if (!args[1].is_string()) {
+    return RejectJavascriptCallback(callback_id, "invalid layout");
+  }
+
+  const std::string& layout = args[1].GetString();
+  HeliumLayoutType type;
+  if (layout == "horizontal") {
+    type = HeliumLayoutType::kClassic;
+  } else if (layout == "vertical") {
+    type = HeliumLayoutType::kVertical;
+  } else {
+    return RejectJavascriptCallback(callback_id, "unknown tab layout");
+  }
+
+  pref_service_->SetInteger(::prefs::kHeliumLayout, std::to_underlying(type));
+  ResolveJavascriptCallback(callback_id, {});
+}
