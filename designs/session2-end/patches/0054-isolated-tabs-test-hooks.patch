+// "name@url" or "url".
+void OpenSpec(BrowserWindowInterface* browser,
+              const std::string& spec,
+              std::vector<base::WeakPtr<content::WebContents>>* opened) {
+  std::string name;
+  std::string url_text = spec;
+  const size_t at = spec.find('@');
+  if (at != std::string::npos &&
+      spec.substr(0, at).find_first_of(":/") == std::string::npos) {
+    name = spec.substr(0, at);
+    url_text = spec.substr(at + 1);
+  }
+  GURL url(url_text);
+  if (url.is_valid() && url.SchemeIsHTTPOrHTTPS()) {
+    if (content::WebContents* contents =
+            OpenIsolatedTab(browser, url, name)) {
+      opened->push_back(contents->GetWeakPtr());
+    }
+  }
+}
+
+void OpenSpecs(const std::string& specs,
+               std::vector<base::WeakPtr<content::WebContents>>* opened) {
+  BrowserWindowInterface* browser =
+      GetLastActiveBrowserWindowInterfaceWithAnyProfile();
+  if (!browser) {
+    return;
+  }
+  for (const auto& spec : base::SplitString(specs, ",", base::TRIM_WHITESPACE,
+                                            base::SPLIT_WANT_NONEMPTY)) {
+    OpenSpec(browser, spec, opened);
+  }
+}
+
+void CloseAll(std::vector<base::WeakPtr<content::WebContents>> opened) {
+  BrowserWindowInterface* browser =
+      GetLastActiveBrowserWindowInterfaceWithAnyProfile();
+  if (!browser) {
+    return;
+  }
+  for (const auto& weak : opened) {
+    if (!weak) {
+      continue;
+    }
+    const int index = browser->GetTabStripModel()->GetIndexOfWebContents(weak.get());
+    if (index != TabStripModel::kNoTab) {
+      browser->GetTabStripModel()->CloseWebContentsAt(index, CLOSE_NONE);
+    }
+  }
+}
