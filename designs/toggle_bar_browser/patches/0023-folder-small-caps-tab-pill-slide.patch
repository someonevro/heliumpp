 TabView::~TabView() = default;
 
+namespace {
+// Screen y of the most recently activated tab, and the direction of the move.
+// Shared by all tabs so the previous and the new tab agree on it.
+int g_last_active_y = 0;
+bool g_select_travel_down = true;
+
+class SelectAnimationDelegate : public gfx::AnimationDelegate {
+ public:
+  explicit SelectAnimationDelegate(views::View* view) : view_(view) {}
+  void AnimationProgressed(const gfx::Animation*) override {
+    view_->SchedulePaint();
+  }
+  void AnimationEnded(const gfx::Animation*) override { view_->SchedulePaint(); }
+
+ private:
+  raw_ptr<views::View> view_;
+};
+}  // namespace
+
+bool TabView::IsSelectAnimationRunning(float* value) const {
+  if (!select_animation_ || !select_animation_->is_animating()) {
+    return false;
+  }
+  *value = static_cast<float>(select_animation_->GetCurrentValue());
+  return true;
+}
+
+// static
+bool TabView::IsSelectTravelDown() {
+  return g_select_travel_down;
+}
