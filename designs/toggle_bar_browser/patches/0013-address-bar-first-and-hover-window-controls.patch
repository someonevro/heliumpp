 OpaqueBrowserFrameView::~OpaqueBrowserFrameView() = default;
 
+constexpr int kRevealHotZoneWidth = 200;
+constexpr int kRevealHotZoneHeight = 14;
+constexpr int kRevealMargin = 12;
+
+bool OpaqueBrowserFrameView::ShouldAutoHideCaptionButtons() const {
+  static const bool disabled =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("no-sidebar-toolbar");
+  auto* controller =
+      HeliumLayoutStateController::From(GetBrowserView()->browser());
+  return !disabled && controller && controller->IsVerticalLayout() &&
+         !controller->IsZenModeEnabled();
+}
+
+gfx::Rect OpaqueBrowserFrameView::CaptionButtonsBounds() const {
+  gfx::Rect bounds;
+  for (views::Button* button : {minimize_button_.get(), maximize_button_.get(),
+                                restore_button_.get(), close_button_.get()}) {
+    if (button && button->GetVisible()) {
+      bounds.Union(button->bounds());
+    }
+  }
+  return bounds;
+}
+
+void OpaqueBrowserFrameView::SetUpCaptionButtonReveal() {
+  reveal_animation_.SetSlideDuration(base::Milliseconds(160));
+  reveal_animation_.Reset(0);
+  for (views::Button* button : {minimize_button_.get(), maximize_button_.get(),
+                                restore_button_.get(), close_button_.get()}) {
+    if (button) {
+      button->SetPaintToLayer();
+      button->layer()->SetFillsBoundsOpaquely(false);
+    }
+  }
+  UpdateCaptionButtonReveal();
+}
+
+void OpaqueBrowserFrameView::UpdateCaptionButtonReveal() {
+  const double amount =
+      ShouldAutoHideCaptionButtons() ? reveal_animation_.GetCurrentValue() : 1.0;
+  for (views::Button* button : {minimize_button_.get(), maximize_button_.get(),
+                                restore_button_.get(), close_button_.get()}) {
+    if (!button || !button->layer()) {
+      continue;
+    }
+    button->layer()->SetOpacity(amount);
+    gfx::Transform slide;
+    slide.Translate(0, -(1.0 - amount) * button->height());
+    button->layer()->SetTransform(slide);
+    // Hidden buttons must neither be clickable nor count as caption buttons in
+    // hit testing (see HitTestCaptionButton).
+    button->SetCanProcessEventsWithinSubtree(amount > 0.5);
+  }
+}
+
+void OpaqueBrowserFrameView::AddedToWidget() {
+  BrowserFrameView::AddedToWidget();
+  reveal_event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, GetWidget()->GetNativeWindow(),
+      {ui::EventType::kMouseMoved, ui::EventType::kMouseEntered,
+       ui::EventType::kMouseExited});
+  SetUpCaptionButtonReveal();
+}
+
+void OpaqueBrowserFrameView::OnEvent(const ui::Event& event) {
+  if (!event.IsMouseEvent() || !ShouldAutoHideCaptionButtons()) {
+    UpdateCaptionButtonReveal();
+    return;
+  }
+  const gfx::Point point =
+      gfx::ToFlooredPoint(event.AsMouseEvent()->root_location_f());
+  const gfx::Rect bounds = GetLocalBounds();
+  const bool in_hot_zone = point.x() >= bounds.right() - kRevealHotZoneWidth &&
+                           point.y() <= kRevealHotZoneHeight;
+  gfx::Rect controls = CaptionButtonsBounds();
+  controls.Outset(kRevealMargin);
+  const bool on_controls =
+      reveal_animation_.IsShowing() && controls.Contains(point);
+  if (in_hot_zone || on_controls) {
+    reveal_hide_timer_.Stop();
+    reveal_animation_.Show();
+  } else if (reveal_animation_.IsShowing() && !reveal_hide_timer_.IsRunning()) {
+    reveal_hide_timer_.Start(
+        FROM_HERE, base::Milliseconds(350),
+        base::BindOnce(&gfx::SlideAnimation::Hide,
+                       base::Unretained(&reveal_animation_)));
+  }
+}
+
+void OpaqueBrowserFrameView::AnimationProgressed(
+    const gfx::Animation* animation) {
+  UpdateCaptionButtonReveal();
+}
+
+void OpaqueBrowserFrameView::AnimationEnded(const gfx::Animation* animation) {
+  UpdateCaptionButtonReveal();
+}
