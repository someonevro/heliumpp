+void VerticalTabStripFooter::AddPrivacyButton() {
+  auto button = views::CreateVectorImageButtonWithNativeTheme(
+      views::Button::PressedCallback(), vector_icons::kLockIcon, kIconSize);
+  views::View* anchor = button.get();
+  button->SetCallback(base::BindRepeating(
+      &VerticalTabStripFooter::ShowPrivacyMenu, base::Unretained(this),
+      base::Unretained(anchor)));
+  button->SetTooltipText(u"Privacy level");
+  button->SetPreferredSize(gfx::Size(kButtonSize, kButtonSize));
+  button->SetProperty(views::kMarginsKey, gfx::Insets::VH(1, 0));
+  AddChildView(std::move(button));
+}
+
+void VerticalTabStripFooter::ShowPrivacyMenu(views::View* anchor) {
+  privacy_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  privacy_menu_model_->AddRadioItem(kPrivacyLow, u"Low", 0);
+  privacy_menu_model_->AddRadioItem(kPrivacyMedium, u"Medium (Recommended)", 0);
+  privacy_menu_model_->AddRadioItem(kPrivacyHigh, u"High", 0);
+  privacy_menu_runner_ = std::make_unique<views::MenuRunner>(
+      privacy_menu_model_.get(), views::MenuRunner::HAS_MNEMONICS);
+  privacy_menu_runner_->RunMenuAt(
+      anchor->GetWidget(), nullptr, anchor->GetBoundsInScreen(),
+      views::MenuAnchorPosition::kTopLeft, ui::mojom::MenuSourceType::kMouse);
+}
+
+bool VerticalTabStripFooter::IsCommandIdChecked(int command_id) const {
+  const char* mode = ModeForCommand(command_id);
+  return mode &&
+         helium_privacy_mode::GetModeName(browser_->GetProfile()) == mode;
+}
+
+void VerticalTabStripFooter::ExecuteCommand(int command_id, int event_flags) {
+  if (const char* mode = ModeForCommand(command_id)) {
+    helium_privacy_mode::SetMode(browser_->GetProfile(), mode);
+  }
+}
