+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_PRIVACY_TOGGLE_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_PRIVACY_TOGGLE_VIEW_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
