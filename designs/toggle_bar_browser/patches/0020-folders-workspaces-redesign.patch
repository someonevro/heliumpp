+#ifndef CHROME_BROWSER_HELIUM_WORKSPACES_HELIUM_WORKSPACES_H_
+#define CHROME_BROWSER_HELIUM_WORKSPACES_HELIUM_WORKSPACES_H_
+
+#include <string>
+#include <vector>
+
+class BrowserWindowInterface;
+class PrefRegistrySimple;
+class Profile;
+
+// Workspaces: named sets of tabs (with pinned state and tab groups) kept in
+// the profile's prefs. Only one workspace is live at a time. Switching saves the
+// URLs of the live tabs, closes them, and reopens the target workspace's tabs,
+// so inactive tabs lose scroll position and form state. The active workspace is
+// per profile, shared by all windows of that profile.
+namespace helium_workspaces {
+
+inline constexpr char kWorkspacesPref[] = "helium.workspaces";
+inline constexpr char kActiveWorkspacePref[] = "helium.workspaces_active";
+
+struct Info {
+  std::string id;
+  std::string name;
+};
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+// Always returns at least one workspace.
+std::vector<Info> List(Profile* profile);
+std::string ActiveId(Profile* profile);
+
+// Saves the live tabs into the current workspace, then makes `id` live.
+void Switch(BrowserWindowInterface* browser, const std::string& id);
+// Creates an empty workspace ("Workspace N") and switches to it.
+void Create(BrowserWindowInterface* browser);
+// Deletes a workspace (not the last one). Deleting the live one switches first.
+void Delete(BrowserWindowInterface* browser, const std::string& id);
+
+}  // namespace helium_workspaces
+
+#endif  // CHROME_BROWSER_HELIUM_WORKSPACES_HELIUM_WORKSPACES_H_
