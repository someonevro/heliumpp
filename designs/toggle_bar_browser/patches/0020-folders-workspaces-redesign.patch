+
+// A row of round chips at the bottom of the sidebar, one per workspace, plus a
+// "+" chip that creates a workspace. Clicking a chip switches to it; right-click
+// offers deleting it. See helium_workspaces.h for what switching does.
+class WorkspaceSwitcher : public views::FlexLayoutView,
+                          public views::ContextMenuController,
+                          public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(WorkspaceSwitcher, views::FlexLayoutView)
+
+ public:
+  explicit WorkspaceSwitcher(BrowserWindowInterface* browser);
+  ~WorkspaceSwitcher() override;
+
+ private:
+  void Rebuild();
+  // Prefs change while a chip's own click is running, so rebuild afterwards.
+  void ScheduleRebuild();
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  PrefChangeRegistrar pref_registrar_;
+  std::string menu_workspace_id_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  // Parallel to the chips: the workspace id behind each child view.
+  std::vector<std::pair<raw_ptr<views::View>, std::string>> chips_;
+  base::WeakPtrFactory<WorkspaceSwitcher> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_SWITCHER_H_
