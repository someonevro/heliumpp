+
+namespace {
+constexpr int kChipSize = 28;
+constexpr int kChipRadius = 10;
+constexpr int kDeleteCommand = 1;
+}  // namespace
+
+WorkspaceSwitcher::WorkspaceSwitcher(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetMainAxisAlignment(views::LayoutAlignment::kCenter);
+  SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  pref_registrar_.Init(prefs);
+  auto rebuild = base::BindRepeating(&WorkspaceSwitcher::ScheduleRebuild,
+                                     base::Unretained(this));
+  pref_registrar_.Add(helium_workspaces::kWorkspacesPref, rebuild);
+  pref_registrar_.Add(helium_workspaces::kActiveWorkspacePref, rebuild);
+  Rebuild();
+}
+
+WorkspaceSwitcher::~WorkspaceSwitcher() = default;
+
+void WorkspaceSwitcher::ScheduleRebuild() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceSwitcher::Rebuild,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceSwitcher::Rebuild() {
+  RemoveAllChildViews();
+  chips_.clear();
+  Profile* profile = browser_->GetProfile();
+  const std::string active = helium_workspaces::ActiveId(profile);
+
+  auto add_chip = [&](std::u16string label, std::u16string tooltip,
+                      base::RepeatingClosure action, bool selected) {
+    auto chip = std::make_unique<views::LabelButton>(
+        base::BindRepeating([](base::RepeatingClosure action,
+                               const ui::Event&) { action.Run(); },
+                            std::move(action)),
+        std::move(label));
+    chip->SetTooltipText(std::move(tooltip));
+    chip->SetPreferredSize(gfx::Size(kChipSize, kChipSize));
+    chip->SetMinSize(gfx::Size(kChipSize, kChipSize));
+    // Both colours are theme tokens, so the chips follow the wallpaper theme.
+    if (selected) {
+      chip->SetBackground(views::CreateRoundedRectBackground(
+          kColorTabBackgroundActiveFrameActive, kChipRadius));
+    }
+    chip->SetProperty(views::kMarginsKey, gfx::Insets::VH(1, 2));
+    return AddChildView(std::move(chip));
+  };
+
+  for (const helium_workspaces::Info& info :
+       helium_workspaces::List(profile)) {
+    std::u16string name = base::UTF8ToUTF16(info.name);
+    std::u16string letter = base::i18n::ToUpper(name.substr(0, 1));
+    views::View* chip = add_chip(
+        letter, name,
+        base::BindRepeating(
+            [](WorkspaceSwitcher* self, std::string id) {
+              helium_workspaces::Switch(self->browser_, id);
+            },
+            base::Unretained(this), info.id),
+        info.id == active);
+    chip->set_context_menu_controller(this);
+    chips_.emplace_back(chip, info.id);
+  }
+  add_chip(u"+", u"New workspace",
+           base::BindRepeating(
+               [](WorkspaceSwitcher* self) {
+                 helium_workspaces::Create(self->browser_);
+               },
+               base::Unretained(this)),
+           false);
+  InvalidateLayout();
+}
+
+void WorkspaceSwitcher::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  for (const auto& [view, id] : chips_) {
+    if (view == source) {
+      menu_workspace_id_ = id;
+    }
+  }
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItem(kDeleteCommand, u"Delete workspace");
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void WorkspaceSwitcher::ExecuteCommand(int command_id, int event_flags) {
+  if (command_id == kDeleteCommand) {
+    helium_workspaces::Delete(browser_, menu_workspace_id_);
+  }
+}
