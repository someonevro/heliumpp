+namespace {
+
+constexpr char kDefaultId[] = "main";
+
+base::DictValue NewRecord(const std::string& id, const std::string& name) {
+  base::DictValue record;
+  record.Set("id", id);
+  record.Set("name", name);
+  record.Set("tabs", base::ListValue());
+  record.Set("groups", base::ListValue());
+  return record;
+}
+
+// Makes sure the pref holds at least one workspace and a valid active id.
+void EnsureDefault(Profile* profile) {
+  PrefService* prefs = profile->GetPrefs();
+  base::ListValue list = prefs->GetList(kWorkspacesPref).Clone();
+  if (list.empty()) {
+    list.Append(NewRecord(kDefaultId, "Main"));
+    prefs->SetList(kWorkspacesPref, std::move(list));
+    prefs->SetString(kActiveWorkspacePref, kDefaultId);
+    return;
+  }
+  const std::string active = prefs->GetString(kActiveWorkspacePref);
+  for (const base::Value& item : list) {
+    const base::DictValue* dict = item.GetIfDict();
+    if (dict && dict->FindString("id") && *dict->FindString("id") == active) {
+      return;
+    }
+  }
+  const std::string* first = list.front().GetDict().FindString("id");
+  prefs->SetString(kActiveWorkspacePref, first ? *first : kDefaultId);
+}
+
+base::DictValue* FindRecord(base::ListValue& list, const std::string& id) {
+  for (base::Value& item : list) {
+    base::DictValue* dict = item.GetIfDict();
+    if (dict && dict->FindString("id") && *dict->FindString("id") == id) {
+      return dict;
+    }
+  }
+  return nullptr;
+}
+
+// Records the URL, pinned state and group of every live tab.
+void Snapshot(TabStripModel* model,
+              base::ListValue& tabs,
+              base::ListValue& groups) {
+  std::vector<tab_groups::TabGroupId> group_ids;
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetTabAtIndex(i)->GetContents();
+    GURL url = contents->GetLastCommittedURL();
+    if (url.is_empty()) {
+      url = contents->GetVisibleURL();
+    }
+    if (!url.is_valid() || url.is_empty()) {
+      continue;
+    }
+    base::DictValue tab;
+    tab.Set("url", url.spec());
+    const bool pinned = model->IsTabPinned(i);
+    tab.Set("pinned", pinned);
+    std::optional<tab_groups::TabGroupId> group = model->GetTabGroupForTab(i);
+    if (group && !pinned) {
+      size_t index = 0;
+      while (index < group_ids.size() && group_ids[index] != *group) {
+        ++index;
+      }
+      if (index == group_ids.size()) {
+        group_ids.push_back(*group);
+        const tab_groups::TabGroupVisualData* visual =
+            model->group_model()->GetTabGroup(*group)->visual_data();
+        base::DictValue dict;
+        dict.Set("title", base::UTF16ToUTF8(visual->title()));
+        dict.Set("color", static_cast<int>(visual->color()));
+        dict.Set("collapsed", visual->is_collapsed());
+        groups.Append(std::move(dict));
+      }
+      tab.Set("group", static_cast<int>(index));
+    }
+    tabs.Append(std::move(tab));
+  }
+}
+
+// Opens the saved tabs after the existing ones and returns their handles in
+// saved order.
+std::vector<tabs::TabInterface*> Restore(BrowserWindowInterface* browser,
+                                         const base::DictValue& record) {
+  TabStripModel* model = browser->GetTabStripModel();
+  const base::ListValue* tabs = record.FindList("tabs");
+  const base::ListValue* groups = record.FindList("groups");
+
+  std::vector<tabs::TabInterface*> handles;
+  std::vector<std::vector<tabs::TabInterface*>> group_members(
+      groups ? groups->size() : 0);
+  std::vector<tabs::TabInterface*> pinned_tabs;
+  if (tabs) {
+    for (const base::Value& item : *tabs) {
+      const base::DictValue* dict = item.GetIfDict();
+      const std::string* url = dict ? dict->FindString("url") : nullptr;
+      if (!url) {
+        continue;
+      }
+      chrome::AddTabAt(browser, GURL(*url), model->count(),
+                       /*foreground=*/false);
+      tabs::TabInterface* handle = model->GetTabAtIndex(model->count() - 1);
+      handles.push_back(handle);
+      if (dict->FindBool("pinned").value_or(false)) {
+        pinned_tabs.push_back(handle);
+      } else if (std::optional<int> group = dict->FindInt("group")) {
+        if (*group >= 0 && *group < static_cast<int>(group_members.size())) {
+          group_members[*group].push_back(handle);
+        }
+      }
+    }
+  }
+  if (handles.empty()) {
+    chrome::AddTabAt(browser, GURL(chrome::kChromeUINewTabURL), model->count(),
+                     /*foreground=*/false);
+    handles.push_back(model->GetTabAtIndex(model->count() - 1));
+  }
+
+  for (size_t g = 0; g < group_members.size(); ++g) {
+    if (group_members[g].empty()) {
+      continue;
+    }
+    std::vector<int> indices;
+    for (tabs::TabInterface* handle : group_members[g]) {
+      indices.push_back(model->GetIndexOfTab(handle));
+    }
+    const tab_groups::TabGroupId id = model->AddToNewGroup(indices);
+    const base::DictValue& info = (*groups)[g].GetDict();
+    const std::string* title = info.FindString("title");
+    model->ChangeTabGroupVisuals(
+        id, tab_groups::TabGroupVisualData(
+                base::UTF8ToUTF16(title ? *title : std::string()),
+                static_cast<tab_groups::TabGroupColorId>(
+                    info.FindInt("color").value_or(0)),
+                info.FindBool("collapsed").value_or(false)));
+  }
+  for (tabs::TabInterface* handle : pinned_tabs) {
+    model->SetTabPinned(model->GetIndexOfTab(handle), true);
+  }
+  return handles;
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterListPref(kWorkspacesPref);
+  registry->RegisterStringPref(kActiveWorkspacePref, std::string());
+}
+
+std::vector<Info> List(Profile* profile) {
+  EnsureDefault(profile);
+  std::vector<Info> result;
+  for (const base::Value& item :
+       profile->GetPrefs()->GetList(kWorkspacesPref)) {
+    const base::DictValue* dict = item.GetIfDict();
+    const std::string* id = dict ? dict->FindString("id") : nullptr;
+    const std::string* name = dict ? dict->FindString("name") : nullptr;
+    if (id && name) {
+      result.push_back({*id, *name});
+    }
+  }
+  return result;
+}
+
+std::string ActiveId(Profile* profile) {
+  EnsureDefault(profile);
+  return profile->GetPrefs()->GetString(kActiveWorkspacePref);
+}
+
+void Switch(BrowserWindowInterface* browser, const std::string& id) {
+  Profile* profile = browser->GetProfile();
+  EnsureDefault(profile);
+  PrefService* prefs = profile->GetPrefs();
+  const std::string current = prefs->GetString(kActiveWorkspacePref);
+  if (id == current) {
+    return;
+  }
+  base::ListValue list = prefs->GetList(kWorkspacesPref).Clone();
+  base::DictValue* target = FindRecord(list, id);
+  base::DictValue* source = FindRecord(list, current);
+  if (!target) {
+    return;
+  }
+
+  TabStripModel* model = browser->GetTabStripModel();
+  if (source) {
+    base::ListValue tabs;
+    base::ListValue groups;
+    Snapshot(model, tabs, groups);
+    source->Set("tabs", std::move(tabs));
+    source->Set("groups", std::move(groups));
+  }
+  const base::DictValue target_copy = target->Clone();
+  prefs->SetList(kWorkspacesPref, std::move(list));
+  prefs->SetString(kActiveWorkspacePref, id);
+
+  std::vector<tabs::TabInterface*> old_tabs;
+  for (int i = 0; i < model->count(); ++i) {
+    old_tabs.push_back(model->GetTabAtIndex(i));
+  }
+  std::vector<tabs::TabInterface*> opened = Restore(browser, target_copy);
+  model->ActivateTabAt(model->GetIndexOfTab(opened.front()));
+  for (tabs::TabInterface* tab : old_tabs) {
+    model->CloseWebContentsAt(model->GetIndexOfTab(tab),
+                              TabCloseTypes::CLOSE_NONE);
+  }
+}
+
+void Create(BrowserWindowInterface* browser) {
+  Profile* profile = browser->GetProfile();
+  EnsureDefault(profile);
+  PrefService* prefs = profile->GetPrefs();
+  base::ListValue list = prefs->GetList(kWorkspacesPref).Clone();
+  const std::string id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  list.Append(NewRecord(
+      id, "Workspace " + base::NumberToString(list.size() + 1)));
+  prefs->SetList(kWorkspacesPref, std::move(list));
+  Switch(browser, id);
+}
+
+void Delete(BrowserWindowInterface* browser, const std::string& id) {
+  Profile* profile = browser->GetProfile();
+  std::vector<Info> all = List(profile);
+  if (all.size() <= 1) {
+    return;
+  }
+  if (id == ActiveId(profile)) {
+    for (const Info& info : all) {
+      if (info.id != id) {
+        Switch(browser, info.id);
+        break;
+      }
+    }
+  }
+  PrefService* prefs = profile->GetPrefs();
+  base::ListValue list = prefs->GetList(kWorkspacesPref).Clone();
+  list.EraseIf([&](const base::Value& item) {
+    const base::DictValue* dict = item.GetIfDict();
+    const std::string* item_id = dict ? dict->FindString("id") : nullptr;
+    return item_id && *item_id == id;
+  });
+  prefs->SetList(kWorkspacesPref, std::move(list));
+}
+
+}  // namespace helium_workspaces
