+<script lang="ts">
+    import { onMount } from "svelte";
+    import { Button, IconCheck, Spinner } from "@imput/helium-prism";
+    import { getPrivacyMode, setPrivacyMode } from "../lib/browser";
+    import { selectedPrivacyMode } from "../lib/onboarding-flow";
+
+    let working = $state(false);
+    let status = $state("");
+
+    onMount(async () => {
+        const current = await getPrivacyMode();
+        if (current) {
+            selectedPrivacyMode.set(current);
+        }
+    });
+
+    const save = async () => {
+        working = true;
+        try {
+            const restart = await setPrivacyMode($selectedPrivacyMode);
+            status = restart
+                ? "Saved. Restart the browser to fully apply fingerprinting and referrer protection."
+                : "Saved.";
+        } catch {
+            status = "Could not save the privacy level.";
+        } finally {
+            working = false;
+        }
+    };
+</script>
+
+<div class="save-bar">
+    <Button primary disabled={working} onclick={save}>
+        {#if working}
+            <Spinner size={18} />
+        {:else}
+            <IconCheck />
+        {/if}
+        Save
+    </Button>
+    <p aria-live="polite">{status}</p>
+</div>
+
+<style>
+    .save-bar {
+        position: fixed;
+        bottom: 24px;
+        left: 50%;
+        transform: translateX(-50%);
+        z-index: 9;
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        gap: 8px;
+        max-width: 560px;
+        text-align: center;
+    }
+
+    p {
+        margin: 0;
+        font-size: 0.9em;
+        opacity: 0.8;
+    }
+</style>
