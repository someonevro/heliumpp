 constexpr char kSwitch[] = "privacy-mode";
+constexpr char kModePref[] = "helium.privacy_mode";
+
+enum class Permissions { kAsk, kAskRestricted, kBlock };
+
+struct Mode {
+  content_settings::CookieControlsMode third_party_cookies;
+  ContentSetting cookies;
+  const char* webrtc_ip_policy;
+  bool https_first;
+  bool https_only;
+  Permissions permissions;
+};
+
+bool GetMode(const std::string& name, Mode* mode) {
+  using content_settings::CookieControlsMode;
+  if (name == "usability") {
+    *mode = {CookieControlsMode::kIncognitoOnly, CONTENT_SETTING_ALLOW,
+             "default", true, false, Permissions::kAsk};
+  } else if (name == "medium") {
+    *mode = {CookieControlsMode::kBlockThirdParty, CONTENT_SETTING_ALLOW,
+             "default_public_interface_only", true, false,
+             Permissions::kAskRestricted};
+  } else if (name == "maximum") {
+    // SESSION_ONLY: cookies and site data are deleted when the browser closes.
+    *mode = {CookieControlsMode::kBlockThirdParty,
+             CONTENT_SETTING_SESSION_ONLY, "disable_non_proxied_udp", false,
+             true, Permissions::kBlock};
+  } else {
+    return false;
+  }
+  return true;
+}
+
 }  // namespace
 
