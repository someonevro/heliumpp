+
+std::optional<GradientColors> ExtractGradientColors(const SkBitmap& bitmap) {
+  if (bitmap.isNull() || bitmap.width() <= 0 || bitmap.height() <= 0) {
+    return std::nullopt;
+  }
+  const int step_x = std::max(1, bitmap.width() / 64);
+  const int step_y = std::max(1, bitmap.height() / 64);
+  constexpr int kBins = 12;  // 30 degrees of hue each.
+  struct Bin {
+    double weight = 0, r = 0, g = 0, b = 0;
+  } bins[kBins];
+  std::vector<double> lightness;
+  double total = 0;
+  int samples = 0;
+  for (int y = 0; y < bitmap.height(); y += step_y) {
+    for (int x = 0; x < bitmap.width(); x += step_x) {
+      const SkColor c = bitmap.getColor(x, y);
+      color_utils::HSL hsl;
+      color_utils::SkColorToHSL(c, &hsl);
+      const double weight = hsl.s * (1 - std::abs(2 * hsl.l - 1));
+      Bin& bin = bins[std::min(kBins - 1, static_cast<int>(hsl.h * kBins))];
+      bin.weight += weight;
+      bin.r += SkColorGetR(c) * weight;
+      bin.g += SkColorGetG(c) * weight;
+      bin.b += SkColorGetB(c) * weight;
+      total += weight;
+      lightness.push_back(hsl.l);
+      ++samples;
+    }
+  }
+  if (samples == 0) {
+    return std::nullopt;
+  }
+  if (total / samples < 0.03) {
+    // Grayscale wallpaper: its darker and lighter tones.
+    std::sort(lightness.begin(), lightness.end());
+    const auto gray = [&](double fraction) {
+      const int v = static_cast<int>(
+          std::lround(255 * lightness[static_cast<size_t>(
+                                fraction * (lightness.size() - 1))]));
+      return SkColorSetRGB(v, v, v);
+    };
+    return GradientColors(gray(0.05), gray(0.95));
+  }
+  const auto bin_color = [&](const Bin& bin) {
+    return SkColorSetRGB(static_cast<int>(std::lround(bin.r / bin.weight)),
+                         static_cast<int>(std::lround(bin.g / bin.weight)),
+                         static_cast<int>(std::lround(bin.b / bin.weight)));
+  };
+  int first = 0;
+  for (int i = 1; i < kBins; ++i) {
+    if (bins[i].weight > bins[first].weight) {
+      first = i;
+    }
+  }
+  // The second color: the strongest hue at least 60 degrees from the first.
+  int second = -1;
+  for (int i = 0; i < kBins; ++i) {
+    const int distance = std::min((i - first + kBins) % kBins,
+                                  (first - i + kBins) % kBins);
+    if (distance >= 2 && bins[i].weight >= 0.25 * bins[first].weight &&
+        (second < 0 || bins[i].weight > bins[second].weight)) {
+      second = i;
+    }
+  }
+  const SkColor color_a = bin_color(bins[first]);
+  if (second >= 0) {
+    return GradientColors(color_a, bin_color(bins[second]));
+  }
+  // One hue family: pair it with a neighbouring hue.
+  color_utils::HSL hsl;
+  color_utils::SkColorToHSL(color_a, &hsl);
+  hsl.h = std::fmod(hsl.h + 40.0 / 360.0, 1.0);
+  return GradientColors(color_a, color_utils::HSLToSkColor(hsl, 255));
+}
