+
+void WorkspaceSwitcher::Layout(PassKey) {
+  const gfx::Rect inner = GetContentsBounds();
+  views::View* add = children().empty() ? nullptr : children().back().get();
+  const int segments = static_cast<int>(children().size()) - (add ? 1 : 0);
+  const int add_width = add ? kSegmentHeight : 0;
+  const int segment_width =
+      segments ? std::max(0, inner.width() - add_width) / segments : 0;
+  int x = inner.x();
+  for (int i = 0; i < segments; ++i) {
+    children()[i]->SetBounds(x, inner.y(), segment_width, kSegmentHeight);
+    x += segment_width;
+  }
+  if (add) {
+    add->SetBounds(inner.right() - add_width, inner.y(), add_width,
+                   kSegmentHeight);
+  }
+}
