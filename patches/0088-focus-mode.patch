--- a/chrome/browser/helium_focus/helium_focus.h
+++ b/chrome/browser/helium_focus/helium_focus.h
@@ -0,0 +1,39 @@
+// Focus mode: per-site switch (page info bubble) that hides feeds, Shorts and
+// recommendations on sites it knows, by adding a stylesheet to their pages.
+
+#ifndef CHROME_BROWSER_HELIUM_FOCUS_HELIUM_FOCUS_H_
+#define CHROME_BROWSER_HELIUM_FOCUS_HELIUM_FOCUS_H_
+
+#include <string_view>
+
+class GURL;
+namespace content {
+class BrowserContext;
+class WebContents;
+}  // namespace content
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace helium_focus {
+
+// Profile pref: list of sites (e.g. "youtube.com") with focus mode on.
+inline constexpr char kFocusSitesPref[] = "helium.focus_sites";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// The site focus mode has rules for that `url` is on, or "" if none.
+std::string_view SupportedSite(const GURL& url);
+
+bool IsEnabled(content::BrowserContext* context, const GURL& url);
+
+// Turns focus mode on or off for the site shown in `web_contents` and applies
+// it to that tab right away (other tabs of the site follow on their next load).
+void SetEnabled(content::WebContents* web_contents, bool enabled);
+
+// Tab helper: applies focus mode whenever a page of a supported site loads.
+void AttachTabHelper(content::WebContents* web_contents);
+
+}  // namespace helium_focus
+
+#endif  // CHROME_BROWSER_HELIUM_FOCUS_HELIUM_FOCUS_H_
--- a/chrome/browser/helium_focus/helium_focus.cc
+++ b/chrome/browser/helium_focus/helium_focus.cc
@@ -0,0 +1,141 @@
+#include "chrome/browser/helium_focus/helium_focus.h"
+
+#include <string>
+
+#include "base/json/string_escape.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "components/user_prefs/user_prefs.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/gurl.h"
+
+namespace helium_focus {
+
+namespace {
+
+struct Rule {
+  std::string_view site;
+  std::string_view css;
+};
+
+// Selectors checked against the live sites (logged out, 2026-10-24); sites
+// change their markup, so these need upkeep.
+constexpr Rule kRules[] = {
+    {"youtube.com",
+     // Shorts: menu entries, shelves and single results.
+     "ytd-guide-entry-renderer:has(a[title=\"Shorts\"]),"
+     "ytd-mini-guide-entry-renderer[aria-label=\"Shorts\"],"
+     "grid-shelf-view-model:has(ytm-shorts-lockup-view-model),"
+     "ytd-reel-shelf-renderer,"
+     "ytd-video-renderer:has(a[href^=\"/shorts/\"]),"
+     // Home feed, "up next" column and the end-of-video wall.
+     "ytd-browse[page-subtype=\"home\"] ytd-rich-grid-renderer,"
+     "#related,ytd-watch-next-secondary-results-renderer,"
+     ".ytp-endscreen-content,.ytp-ce-element"
+     "{display:none!important}"},
+};
+
+const Rule* RuleFor(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return nullptr;
+  }
+  for (const Rule& rule : kRules) {
+    if (url.DomainIs(rule.site)) {
+      return &rule;
+    }
+  }
+  return nullptr;
+}
+
+class FocusTabHelper : public content::WebContentsObserver,
+                       public content::WebContentsUserData<FocusTabHelper> {
+ public:
+  // Adds (or empties, when off) our <style> in the main frame. Runs in an
+  // isolated world, so page scripts cannot see or replace the function.
+  void Apply(bool enabled) {
+    const Rule* rule = RuleFor(web_contents()->GetLastCommittedURL());
+    if (!rule) {
+      return;
+    }
+    std::string css;
+    base::EscapeJSONString(enabled ? rule->css : "", /*put_in_quotes=*/true,
+                           &css);
+    web_contents()->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+        base::UTF8ToUTF16(base::StrCat(
+            {"(() => {let s = document.getElementById('helium-focus');"
+             "if (!s) {s = document.createElement('style');"
+             "s.id = 'helium-focus';"
+             "(document.head || document.documentElement).append(s);}"
+             "s.textContent = ",
+             css, ";})()"})),
+        base::NullCallback(), ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  }
+
+ private:
+  explicit FocusTabHelper(content::WebContents* web_contents)
+      : content::WebContentsObserver(web_contents),
+        content::WebContentsUserData<FocusTabHelper>(*web_contents) {}
+  friend class content::WebContentsUserData<FocusTabHelper>;
+
+  void PrimaryMainDocumentElementAvailable() override {
+    if (IsEnabled(web_contents()->GetBrowserContext(),
+                  web_contents()->GetLastCommittedURL())) {
+      Apply(true);
+    }
+  }
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(FocusTabHelper);
+
+}  // namespace
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterListPref(kFocusSitesPref);
+}
+
+std::string_view SupportedSite(const GURL& url) {
+  const Rule* rule = RuleFor(url);
+  return rule ? rule->site : std::string_view();
+}
+
+bool IsEnabled(content::BrowserContext* context, const GURL& url) {
+  const Rule* rule = RuleFor(url);
+  return rule && user_prefs::UserPrefs::Get(context)
+                     ->GetList(kFocusSitesPref)
+                     .contains(rule->site);
+}
+
+void SetEnabled(content::WebContents* web_contents, bool enabled) {
+  const Rule* rule = RuleFor(web_contents->GetLastCommittedURL());
+  if (!rule) {
+    return;
+  }
+  {
+    ScopedListPrefUpdate update(
+        user_prefs::UserPrefs::Get(web_contents->GetBrowserContext()),
+        kFocusSitesPref);
+    update->EraseValue(base::Value(rule->site));
+    if (enabled) {
+      update->Append(rule->site);
+    }
+  }
+  AttachTabHelper(web_contents);
+  FocusTabHelper::FromWebContents(web_contents)->Apply(enabled);
+}
+
+void AttachTabHelper(content::WebContents* web_contents) {
+  FocusTabHelper::CreateForWebContents(web_contents);
+}
+
+}  // namespace helium_focus
