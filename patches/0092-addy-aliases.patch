+}  // namespace
+
+// Asks for the API key, stores it encrypted, then inserts an alias.
+void AskForKey(content::WebContents* contents, std::u16string problem) {
+  ui::DialogModel::Builder builder;
+  ui::DialogModel* model = builder.model();
+  builder.SetTitle(u"Throwaway email with addy.io")
+      .AddParagraph(ui::DialogModelLabel(
+          problem + (problem.empty() ? u"" : u" ") +
+          u"Paste an API key from app.addy.io (Settings, API Keys). It is "
+          u"stored encrypted on this device."))
+      .AddTextfield(kKeyFieldId, u"API key", std::u16string(),
+                    ui::DialogModelTextfield::Params().SetAccessibleName(
+                        u"addy.io API key"))
+      .SetInitiallyFocusedField(kKeyFieldId)
+      .AddOkButton(
+          base::BindOnce(
+              [](ui::DialogModel* model,
+                 base::WeakPtr<content::WebContents> contents) {
+                const std::string key = base::UTF16ToUTF8(
+                    model->GetTextfieldByUniqueId(kKeyFieldId)->text());
+                if (!contents || key.empty()) {
+                  return;
+                }
+                g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+                    [](base::WeakPtr<content::WebContents> contents,
+                       std::string key,
+                       scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+                      std::string encrypted;
+                      if (!contents ||
+                          !encryptor->EncryptString(key, &encrypted)) {
+                        return;
+                      }
+                      Profile::FromBrowserContext(contents->GetBrowserContext())
+                          ->GetPrefs()
+                          ->SetString(kAddyKeyPref,
+                                      base::Base64Encode(encrypted));
+                      AliasRequest::Start(contents.get(), key);
+                    },
+                    contents, key));
+              },
+              model, contents->GetWeakPtr()),
+          ui::DialogModel::Button::Params().SetLabel(u"Save and insert"))
+      .AddCancelButton(base::DoNothing());
+  chrome::ShowTabModal(builder.Build(), contents);
+}
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterStringPref(kAddyKeyPref, std::string());
+}
+
+void InsertAlias(content::WebContents* web_contents) {
+  std::string encrypted;
+  if (!base::Base64Decode(Profile::FromBrowserContext(
+                              web_contents->GetBrowserContext())
+                              ->GetPrefs()
+                              ->GetString(kAddyKeyPref),
+                          &encrypted) ||
+      encrypted.empty()) {
+    AskForKey(web_contents, std::u16string());
+    return;
+  }
+  g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+      [](base::WeakPtr<content::WebContents> contents, std::string encrypted,
+         scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+        std::string key;
+        if (!contents) {
+          return;
+        }
+        // E.g. the keyring changed: ask again rather than fail silently.
+        if (!encryptor->DecryptString(encrypted, &key) || key.empty()) {
+          AskForKey(contents.get(), u"The saved API key could not be read.");
+          return;
+        }
+        AliasRequest::Start(contents.get(), std::move(key));
+      },
+      web_contents->GetWeakPtr(), std::move(encrypted)));
+}
