+          "description."
+        destination: OTHER
+        destination_other: "app.addy.io"
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Only runs when the user picks the menu item."
+        policy_exception_justification: "Not implemented."
+      })");
