+// Throwaway email addresses from addy.io: "Insert throwaway email" in the
+// context menu of text and email fields creates a new alias and types it in.
+
+#ifndef CHROME_BROWSER_HELIUM_ALIASES_HELIUM_ALIASES_H_
+#define CHROME_BROWSER_HELIUM_ALIASES_HELIUM_ALIASES_H_
+
+namespace content {
+class WebContents;
+}
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace helium_aliases {
+
+// Profile pref: the user's addy.io API key, encrypted with OSCrypt, base64.
+inline constexpr char kAddyKeyPref[] = "helium.addy_key";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// Creates an alias described with the site of `web_contents` and replaces the
+// selection of its focused field with it. Asks for the API key first when
+// none is stored (or addy.io rejected it); shows a dialog on other errors.
+void InsertAlias(content::WebContents* web_contents);
+
+}  // namespace helium_aliases
+
+#endif  // CHROME_BROWSER_HELIUM_ALIASES_HELIUM_ALIASES_H_
