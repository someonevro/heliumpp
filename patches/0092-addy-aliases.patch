+void ShowMessage(content::WebContents* contents, std::u16string text) {
+  chrome::ShowTabModal(ui::DialogModel::Builder()
+                           .SetTitle(u"Throwaway email")
+                           .AddParagraph(ui::DialogModelLabel(std::move(text)))
+                           .AddOkButton(base::DoNothing())
+                           .Build(),
+                       contents);
+}
+
+// One alias request: account-details (default domain and format), then
+// creating the alias. Deletes itself when done.
+class AliasRequest {
+ public:
+  static void Start(content::WebContents* contents, std::string key) {
+    auto* request = new AliasRequest(contents, std::move(key));
+    request->Send("account-details", std::nullopt);
+  }
+
+ private:
+  AliasRequest(content::WebContents* contents, std::string key)
+      : contents_(contents->GetWeakPtr()),
+        site_(net::registry_controlled_domains::GetDomainAndRegistry(
+            contents->GetLastCommittedURL(),
+            net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES)),
+        key_(std::move(key)),
+        factory_(contents->GetBrowserContext()
+                     ->GetDefaultStoragePartition()
+                     ->GetURLLoaderFactoryForBrowserProcess()) {
+    if (site_.empty()) {
+      site_ = contents->GetLastCommittedURL().host();
+    }
+  }
+
+  void Send(const std::string& path, std::optional<std::string> body) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL(base::StrCat({kApi, path}));
+    request->method = body ? "POST" : "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->headers.SetHeader("Authorization", "Bearer " + key_);
+    request->headers.SetHeader("X-Requested-With", "XMLHttpRequest");
+    request->headers.SetHeader("Accept", "application/json");
+    loader_ = network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+    loader_->SetAllowHttpErrorResults(true);
+    if (body) {
+      loader_->AttachStringForUpload(*body, "application/json");
+    }
+    loader_->DownloadToString(
+        factory_.get(),
+        base::BindOnce(&AliasRequest::OnResponse, base::Unretained(this),
+                       body.has_value()),
+        /*max_body_size=*/256 * 1024);
+  }
+
+  void OnResponse(bool created, std::optional<std::string> body) {
+    const int status = loader_->ResponseInfo() && loader_->ResponseInfo()->headers
+                           ? loader_->ResponseInfo()->headers->response_code()
+                           : 0;
+    std::optional<base::DictValue> json =
+        body ? base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC)
+             : std::nullopt;
+    const base::DictValue* data = json ? json->FindDict("data") : nullptr;
+    if (!contents_) {
+      delete this;
+      return;
+    }
+    if (status == 401) {
+      AskForKey(contents_.get(), u"addy.io did not accept that API key.");
+    } else if (!data) {
+      ShowMessage(contents_.get(),
+                  status ? u"addy.io could not create an alias (HTTP " +
+                               base::NumberToString16(status) + u")."
+                         : u"Could not reach addy.io.");
+    } else if (!created) {
+      const std::string* domain = data->FindString("default_alias_domain");
+      const std::string* format = data->FindString("default_alias_format");
+      base::DictValue alias;
+      alias.Set("domain", domain ? *domain : "anonaddy.me");
+      // "custom" needs a local part we don't have.
+      alias.Set("format", format && *format != "custom" ? *format
+                                                         : "random_words");
+      alias.Set("description", "Helium++: " + site_);
+      Send("aliases", base::WriteJson(alias));
+      return;
+    } else if (const std::string* email = data->FindString("email")) {
+      contents_->Replace(base::UTF8ToUTF16(*email));
+    }
+    delete this;
+  }
+
+  base::WeakPtr<content::WebContents> contents_;
+  std::string site_;
+  const std::string key_;
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+};
