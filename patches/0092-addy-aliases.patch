+constexpr char kApi[] = "https://app.addy.io/api/v1/";
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("helium_addy_alias", R"(
+      semantics {
+        sender: "Helium++ throwaway email"
+        description:
+          "Creates a new email alias at addy.io, the user's own account, and "
+          "inserts it into a form field."
+        trigger: "The user picks Insert throwaway email in a field's menu."
+        data:
