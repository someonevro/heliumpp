+<script lang="ts">
+    import { HeliumLogo } from "@imput/helium-prism";
+    import { currentPage, selectedNewTab } from "../lib/onboarding-flow";
+
+    import PageHeader from "../components/PageHeader.svelte";
+
+    // Screenshots made with scripts/ui_tour.py (scripts/make_ntp_previews.sh).
+    import oursCrimson from "../assets/ntp-previews/ours-crimson.webp";
+    import oursBlue from "../assets/ntp-previews/ours-blue.webp";
+    import oursGreen from "../assets/ntp-previews/ours-green.webp";
+    import bonjourr from "../assets/ntp-previews/bonjourr.webp";
+
+    const visible = $derived($currentPage === "NewTab");
+    const selected = $derived($selectedNewTab);
+</script>
+
+<div id="new-tab-page" class="onboarding-page" class:visible>
+    <div class="scrollable-page">
+        <PageHeader
+            title="Choose your new tab page"
+            subtitle="You can switch any time in Settings, under Appearance."
+            Icon={HeliumLogo}
+            iconHeight="32px"
+        />
+        <div class="page-content">
+            <div class="ntp-list" role="radiogroup" aria-label="New tab page">
+                <button
+                    type="button"
+                    role="radio"
+                    aria-checked={selected === "helium"}
+                    class="ntp-card"
+                    class:selected={selected === "helium"}
+                    onclick={() => selectedNewTab.set("helium")}
+                >
+                    <span class="preview fan" aria-hidden="true">
+                        <img src={oursCrimson} alt="" />
+                        <img src={oursBlue} alt="" />
+                        <img src={oursGreen} alt="" />
+                    </span>
+                    <span class="ntp-name">Helium++ <span class="badge">Default</span></span>
+                    <span class="ntp-desc">
+                        Its colours follow your desktop wallpaper: change the wallpaper and the page
+                        (and the whole browser) changes with it. Search, privacy level and Performance mode
+                        are right on the page.
+                    </span>
+                </button>
+                <button
+                    type="button"
+                    role="radio"
+                    aria-checked={selected === "bonjourr"}
+                    class="ntp-card"
+                    class:selected={selected === "bonjourr"}
+                    onclick={() => selectedNewTab.set("bonjourr")}
+                >
+                    <span class="preview" aria-hidden="true">
+                        <img src={bonjourr} alt="" />
+                    </span>
+                    <span class="ntp-name">Bonjourr</span>
+                    <span class="ntp-desc">
+                        A minimal clock and greeting with many widgets you can customise. Starts with a plain
+                        colour background; photo backgrounds, weather and quotes load from Bonjourr's servers,
+                        so they stay off until you turn them on. Performance mode is only on the Helium++ page.
+                    </span>
+                </button>
+            </div>
+        </div>
+    </div>
+</div>
+
+<style>
+    #new-tab-page {
+        --page-in-delay: 0.1s;
+    }
+
+    .ntp-list {
+        display: grid;
+        grid-template-columns: 1fr 1fr;
+        gap: 12px;
+        width: 100%;
+    }
+
+    .ntp-card {
+        display: flex;
+        flex-direction: column;
+        gap: 6px;
+        padding: 12px;
+        text-align: start;
+        border-radius: 14px;
+        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.12));
+        background: var(--card-background, rgba(255, 255, 255, 0.04));
+        color: inherit;
+        cursor: pointer;
+    }
+
+    .ntp-card.selected {
+        outline: 2px solid var(--accent-color, #6a7dff);
+    }
+
+    .preview {
+        display: block;
+        /* Explicit width: a stretched flex item's width does not feed
+           aspect-ratio, and the fan has no in-flow content to size it. */
+        width: 100%;
+        flex: none;
+        position: relative;
+        aspect-ratio: 888 / 780;
+        border-radius: 10px;
+        overflow: hidden;
+    }
+
+    .preview img {
+        width: 100%;
+        height: 100%;
+        object-fit: cover;
+        display: block;
+    }
+
+    /* The same page under three wallpapers, fanned out so each stays whole. */
+    .preview.fan img {
+        position: absolute;
+        width: 70%;
+        height: auto;
+        aspect-ratio: 888 / 780;
+        border-radius: 8px;
+        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
+    }
+
+    .preview.fan img:nth-child(1) { left: 0; top: 0; }
+    .preview.fan img:nth-child(2) { left: 15%; top: 10%; }
+    .preview.fan img:nth-child(3) { left: 30%; top: 20%; }
+
+    .ntp-name {
+        font-weight: 600;
+        display: flex;
+        align-items: center;
+        gap: 6px;
+    }
+
+    .badge {
+        font-size: 11px;
+        font-weight: 600;
+        padding: 1px 8px;
+        border-radius: 999px;
+        background: var(--accent-color, #3b5bdb);
+        color: white;
+    }
+
+    .ntp-desc {
+        font-size: 13px;
+        opacity: 0.75;
+    }
+
+    @media (max-width: 640px) {
+        .ntp-list {
+            grid-template-columns: 1fr;
+        }
+    }
+</style>
