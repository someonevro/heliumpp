+void WaylandToplevelWindow::SetBlurRegion(
+    std::optional<std::vector<gfx::Rect>> region_px) {
+  auto* manager = connection()->background_effect_manager();
+  if (!manager || (!background_effect_ && !region_px)) {
+    return;
+  }
+  if (!background_effect_) {
+    background_effect_ = manager->GetEffect(root_surface()->surface());
+  }
+  // Double-buffered: applies with the surface's next commit.
+  wl::Object<wl_region> region;
+  if (region_px) {
+    region = root_surface()->CreateRegion(*region_px);
+  }
+  ext_background_effect_surface_v1_set_blur_region(background_effect_.get(),
+                                                   region.get());
+}
