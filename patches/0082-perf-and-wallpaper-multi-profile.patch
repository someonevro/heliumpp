+// Memory and energy saver are browser-wide. Only the first profile to turn
+// performance mode on saves their old values; they move to a profile that still
+// has it on, and are restored when the last one turns it off.
+constexpr const char* kPerfBrowserWideKeys[] = {"mem_state", "mem_aggr",
+                                                "mem_min", "battery"};
+
+Profile* OtherPerformanceModeProfile(Profile* self) {
+  for (Profile* other :
+       g_browser_process->profile_manager()->GetLoadedProfiles()) {
+    if (other != self && IsPerformanceMode(other)) {
+      return other;
+    }
+  }
+  return nullptr;
+}
+
