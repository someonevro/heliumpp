+// Mean luma (Rec. 601, 0-255) on a ~64x64 grid; -1 for an empty bitmap.
+int MeanLuma(const SkBitmap& bitmap) {
+  if (bitmap.isNull() || bitmap.width() <= 0 || bitmap.height() <= 0) {
+    return -1;
+  }
+  const int step_x = std::max(1, bitmap.width() / 64);
+  const int step_y = std::max(1, bitmap.height() / 64);
+  double sum = 0;
+  int samples = 0;
+  for (int y = 0; y < bitmap.height(); y += step_y) {
+    for (int x = 0; x < bitmap.width(); x += step_x) {
+      const SkColor c = bitmap.getColor(x, y);
+      sum += 0.299 * SkColorGetR(c) + 0.587 * SkColorGetG(c) +
+             0.114 * SkColorGetB(c);
+      ++samples;
+    }
+  }
+  return static_cast<int>(sum / samples + 0.5);
+}
