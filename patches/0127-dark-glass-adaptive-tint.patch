 namespace {
 
+// Tint alpha for a dark acrylic frame. 55% looks best, but over a light
+// wallpaper the blurred desktop lifts the glass to mid grey and secondary text
+// fell to 2.4:1. Solve for the alpha that keeps the glass at or below luma 86
+// (secondary text 4.5:1) over the wallpaper's mean luma, x1.35 for brighter
+// patches; unknown wallpaper: the 74% light frames use.
+SkAlpha DarkGlassAlpha(SkColor frame, const PrefService& prefs) {
+  // helium_theme's pref (helium.theme.wallpaper_luma), -1 when unknown.
+  int luma = -1;
+  if (const PrefService::Preference* pref =
+          prefs.FindPreference("helium.theme.wallpaper_luma")) {
+    luma = pref->GetValue()->GetIfInt().value_or(-1);
+  }
+  if (luma < 0) {
+    return 0xBC;
+  }
+  const double backdrop = std::min(255.0, luma * 1.35);
+  const double glass = color_utils::GetLuma(frame);
+  constexpr double kMaxGlassLuma = 86;
+  if (backdrop <= kMaxGlassLuma) {
+    return 0x8C;
+  }
+  const double alpha = (backdrop - kMaxGlassLuma) / (backdrop - glass);
+  return static_cast<SkAlpha>(std::clamp(alpha, 0.55, 0.8) * 255 + 0.5);
+}
