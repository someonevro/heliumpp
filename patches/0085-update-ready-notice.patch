+namespace {
+
+// Desktop notification once the updater has installed a new version (it reports that to
+// BuildState). The vertical layout has no app menu button for Chromium's relaunch chip.
+class UpdateReadyNotifier : public BuildStateObserver {
+ public:
+  void OnUpdate(const BuildState* build_state) override {
+    Profile* profile = ProfileManager::GetLastUsedProfileIfLoaded();
+    if (build_state->update_type() == BuildState::UpdateType::kNone || !profile ||
+        profile->IsSystemProfile()) {
+      return;
+    }
+    message_center::RichNotificationData data;
+    data.buttons.emplace_back(u"Restart now");
+    message_center::Notification notification(
+        message_center::NOTIFICATION_TYPE_SIMPLE, "heliumpp-update-ready",
+        u"Helium++ update ready",
+        u"Version " +
+            base::UTF8ToUTF16(build_state->installed_version()
+                                  ? build_state->installed_version()->GetString()
+                                  : std::string()) +
+            u" is installed. Restart Helium++ to start using it.",
+        ui::ImageModel(), u"Helium++", GURL(),
+        message_center::NotifierId(message_center::NotifierType::SYSTEM_COMPONENT,
+                                   "heliumpp.update"),
+        data,
+        base::MakeRefCounted<message_center::HandleNotificationClickDelegate>(
+            base::BindRepeating([](std::optional<int> button) {
+              if (button) {
+                chrome::AttemptRestart();
+              }
+            })));
+    notification.set_never_timeout(true);
+    NotificationDisplayServiceFactory::GetForProfile(profile)->Display(
+        NotificationHandler::Type::TRANSIENT, notification, nullptr);
+  }
+};
+
+UpdateReadyNotifier& Notifier() {
+  static base::NoDestructor<UpdateReadyNotifier> notifier;
+  return *notifier;
+}
+
+}  // namespace
