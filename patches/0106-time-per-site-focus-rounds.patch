+void NewTabPageHandler::GetTimeToday(GetTimeTodayCallback callback) {
+  const bool enabled =
+      profile_->GetPrefs()->GetBoolean(helium_time::kEnabledPref) &&
+      helium_privacy_mode::GetModeName(profile_) != "maximum";
+  std::vector<new_tab_page::mojom::SiteTimePtr> sites;
+  if (enabled) {
+    for (const auto& [site, seconds] : helium_time::TimeToday(profile_)) {
+      sites.push_back(new_tab_page::mojom::SiteTime::New(site, seconds));
+    }
+  }
+  std::move(callback).Run(enabled, std::move(sites));
+}
+
+void NewTabPageHandler::ResetTimeToday() {
+  helium_time::ResetToday(profile_);
+}
+
+void NewTabPageHandler::GetFocus(GetFocusCallback callback) {
+  const base::Time until = helium_time::FocusUntil(profile_);
+  std::move(callback).Run(helium_time::FocusSites(profile_),
+                          until.is_null() ? 0 : until.InMillisecondsFSinceUnixEpoch());
+}
+
+void NewTabPageHandler::SetFocusSites(const std::vector<std::string>& sites,
+                                      SetFocusSitesCallback callback) {
+  helium_time::SetFocusSites(profile_, sites);
+  std::move(callback).Run(helium_time::FocusSites(profile_));
+}
