+  Pending& p = GetPending();
+  Profile* profile = p.profile.get();
+  if (profile && !p.seconds.empty()) {
+    ScopedDictPrefUpdate update(profile->GetPrefs(), kDaysPref);
+    base::DictValue& days = update.Get();
+    const std::string oldest =
+        DayKey(base::Time::Now() - base::Days(kDaysKept - 1));
+    std::vector<std::string> old;
+    for (const auto [key, value] : days) {
+      if (key < oldest) {
+        old.push_back(key);
+      }
+    }
+    for (const std::string& key : old) {
+      days.Remove(key);
+    }
+    base::DictValue* day = days.EnsureDict(p.day);
+    for (const auto& [site, seconds] : p.seconds) {
+      day->Set(site, day->FindInt(site).value_or(0) + seconds);
+    }
+  }
+  p.seconds.clear();
+  p.ticks = 0;
+}
+
+void Tick() {
+  BrowserWindowInterface* window =
+      GetLastActiveBrowserWindowInterfaceWithAnyProfile();
+  if (!window || !window->IsActive()) {
+    return;
+  }
+  Profile* profile = window->GetProfile();
+  PrefService* prefs = profile->GetPrefs();
+  // Never recorded for incognito or Maximum privacy.
+  if (profile->IsOffTheRecord() || !prefs->GetBoolean(kEnabledPref) ||
+      helium_privacy_mode::GetModeName(profile) == "maximum") {
+    return;
+  }
+  tabs::TabInterface* tab = window->GetActiveTabInterface();
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  // Error pages (like the focus-round page) keep the blocked site's address.
+  if (!contents || helium_privacy_mode::IsIsolatedWebContents(contents) ||
+      contents->GetPrimaryMainFrame()->IsErrorDocument()) {
+    return;
+  }
+  if (ui::CalculateIdleTime() >= kIdleSeconds &&
+      !contents->IsCurrentlyAudible()) {
+    return;
+  }
+  const std::string site = SiteFor(contents->GetLastCommittedURL());
+  if (site.empty()) {
+    return;
+  }
+
+  Pending& p = GetPending();
+  const std::string today = DayKey(base::Time::Now());
+  if (p.profile.get() != profile || p.day != today) {
+    Flush();
+    p.profile = profile->GetWeakPtr();
+    p.day = today;
+  }
+  p.seconds[site] += static_cast<int>(kTick.InSeconds());
+  if (++p.ticks >= kTicksPerWrite) {
+    Flush();
+  }
+}
+
+// The shut site that |url| belongs to, or "" when it is open.
+std::string ShutSite(Profile* profile, const GURL& url) {
+  if (FocusUntil(profile).is_null() || !url.SchemeIsHTTPOrHTTPS()) {
+    return std::string();
+  }
+  const std::string host = base::ToLowerASCII(url.host());
+  for (const std::string& site : FocusSites(profile)) {
+    if (host == site || base::EndsWith(host, "." + site)) {
+      return site;
+    }
+  }
+  return std::string();
+}
+
+class FocusThrottle : public content::NavigationThrottle {
+ public:
+  using content::NavigationThrottle::NavigationThrottle;
+
+  ThrottleCheckResult WillStartRequest() override { return Check(); }
+  ThrottleCheckResult WillRedirectRequest() override { return Check(); }
+  const char* GetNameForLogging() override { return "HeliumFocusThrottle"; }
+
+ private:
+  ThrottleCheckResult Check() {
+    Profile* profile = Profile::FromBrowserContext(
+        navigation_handle()->GetWebContents()->GetBrowserContext());
+    const std::string site = ShutSite(profile, navigation_handle()->GetURL());
+    if (site.empty()) {
+      return PROCEED;
+    }
+    const std::string until =
+        base::UTF16ToUTF8(base::TimeFormatTimeOfDay(FocusUntil(profile)));
+    // System colours only (no fixed palette); follows light/dark.
+    std::string html = base::StrCat(
+        {"<!doctype html><meta charset=utf-8><title>Focus round</title>"
+         "<style>:root{color-scheme:light dark;font-family:system-ui,sans-serif}"
+         "body{display:grid;place-items:center;height:100vh;margin:0;"
+         "background:Canvas;color:CanvasText}p{opacity:.7}</style>"
+         "<div><h1>Focus round</h1><p>",
+         base::EscapeForHTML(site), " opens again at ", base::EscapeForHTML(until),
+         ".</p></div>"});
+    return ThrottleCheckResult(BLOCK_REQUEST, net::ERR_BLOCKED_BY_CLIENT,
+                               std::move(html));
+  }
+};
+
+}  // namespace
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kEnabledPref, true);
+  registry->RegisterDictionaryPref(kDaysPref);
+  registry->RegisterListPref(kFocusSitesPref);
+  registry->RegisterDoublePref(kFocusUntilPref, 0);
+}
+
+void StartTracking() {
+  static base::NoDestructor<base::RepeatingTimer> timer;
+  timer->Start(FROM_HERE, kTick, base::BindRepeating(&Tick));
+  // Last window closed, and quit/logout (SIGTERM skips the first one).
+  static base::NoDestructor<base::CallbackListSubscription> on_quit(
+      browser_shutdown::AddAppTerminatingCallback(base::BindOnce(&Flush)));
+  static base::NoDestructor<base::CallbackListSubscription> on_close_all(
+      chrome::AddClosingAllBrowsersCallback(base::BindRepeating([](bool closing) {
+        if (closing) {
+          Flush();
+        }
+      })));
+}
+
+std::string SiteFor(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return std::string();
+  }
+  std::string site = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  return site.empty() ? std::string(url.host()) : site;
+}
+
+std::string NormalizeSite(const std::string& input) {
+  std::string text(base::TrimWhitespaceASCII(input, base::TRIM_ALL));
+  if (text.empty()) {
+    return std::string();
+  }
+  GURL url(text.find("://") == std::string::npos ? "https://" + text : text);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.host().empty()) {
+    return std::string();
+  }
+  std::string host = base::ToLowerASCII(url.host());
+  if (base::StartsWith(host, "www.")) {
+    host = host.substr(4);
+  }
+  return host;
+}
+
+std::vector<std::pair<std::string, int64_t>> TimeToday(Profile* profile) {
+  std::vector<std::pair<std::string, int64_t>> out;
+  const base::DictValue* today = profile->GetPrefs()
+                                     ->GetDict(kDaysPref)
+                                     .FindDict(DayKey(base::Time::Now()));
+  if (today) {
+    for (const auto [site, seconds] : *today) {
+      if (seconds.is_int()) {
+        out.emplace_back(site, seconds.GetInt());
+      }
+    }
+  }
+  if (const auto* pending = PendingFor(profile)) {
+    for (const auto& [site, seconds] : *pending) {
+      auto it = std::ranges::find(out, site, &std::pair<std::string, int64_t>::first);
+      if (it == out.end()) {
+        out.emplace_back(site, seconds);
+      } else {
+        it->second += seconds;
+      }
+    }
+  }
+  std::ranges::sort(out, [](const auto& a, const auto& b) {
+    return a.second > b.second;
+  });
+  return out;
+}
+
+void ResetToday(Profile* profile) {
+  if (auto* pending = PendingFor(profile)) {
+    pending->clear();
+  }
+  ScopedDictPrefUpdate update(profile->GetPrefs(), kDaysPref);
+  update->Remove(DayKey(base::Time::Now()));
+}
+
+void ForgetSite(Profile* profile, const std::string& site) {
+  if (GetPending().profile.get() == profile) {
+    GetPending().seconds.erase(site);
+  }
+  ScopedDictPrefUpdate update(profile->GetPrefs(), kDaysPref);
+  for (auto [day, sites] : update.Get()) {
+    if (sites.is_dict()) {
+      sites.GetDict().Remove(site);
+    }
+  }
+}
+
+void ClearSince(Profile* profile, base::Time begin) {
+  if (GetPending().profile.get() == profile) {
+    GetPending().seconds.clear();
+  }
+  if (begin.is_null()) {
+    profile->GetPrefs()->ClearPref(kDaysPref);
+    return;
+  }
+  const std::string first = DayKey(begin);
+  ScopedDictPrefUpdate update(profile->GetPrefs(), kDaysPref);
+  std::vector<std::string> gone;
+  for (const auto [day, sites] : update.Get()) {
+    if (day >= first) {
+      gone.push_back(day);
+    }
+  }
+  for (const std::string& day : gone) {
+    update->Remove(day);
+  }
+}
+
+std::vector<std::string> FocusSites(Profile* profile) {
+  std::vector<std::string> out;
+  for (const base::Value& site :
+       profile->GetPrefs()->GetList(kFocusSitesPref)) {
+    if (site.is_string()) {
+      out.push_back(site.GetString());
+    }
+  }
+  return out;
+}
+
+void SetFocusSites(Profile* profile, const std::vector<std::string>& sites) {
+  base::ListValue list;
+  for (const std::string& input : sites) {
+    std::string site = NormalizeSite(input);
+    if (!site.empty() && std::ranges::find(list, base::Value(site)) == list.end()) {
+      list.Append(std::move(site));
+    }
+  }
+  profile->GetPrefs()->SetList(kFocusSitesPref, std::move(list));
+}
+
+base::Time FocusUntil(Profile* profile) {
+  const base::Time until = base::Time::FromSecondsSinceUnixEpoch(
+      profile->GetPrefs()->GetDouble(kFocusUntilPref));
+  return until > base::Time::Now() ? until : base::Time();
+}
+
+void StartFocus(Profile* profile, base::TimeDelta length) {
+  profile->GetPrefs()->SetDouble(
+      kFocusUntilPref,
+      (base::Time::Now() + length).InSecondsFSinceUnixEpoch());
+  for (BrowserWindowInterface* window : GetAllBrowserWindowInterfaces()) {
+    if (window->GetProfile() != profile) {
+      continue;
+    }
+    TabStripModel* tabs = window->GetTabStripModel();
+    for (int i = 0; i < tabs->count(); ++i) {
+      content::WebContents* contents = tabs->GetWebContentsAt(i);
+      // Back/Forward would otherwise restore a shut site from memory, without
+      // a request the throttle could stop.
+      contents->GetController().GetBackForwardCache().Flush();
+      if (!ShutSite(profile, contents->GetLastCommittedURL()).empty()) {
+        contents->GetController().Reload(content::ReloadType::NORMAL, false);
+      }
+    }
+  }
+}
+
+void StopFocus(Profile* profile) {
+  profile->GetPrefs()->SetDouble(kFocusUntilPref, 0);
+}
+
+void MaybeAddFocusThrottle(content::NavigationThrottleRegistry& registry) {
+  if (registry.GetNavigationHandle().IsInPrimaryMainFrame()) {
+    registry.AddThrottle(std::make_unique<FocusThrottle>(registry));
+  }
+}
