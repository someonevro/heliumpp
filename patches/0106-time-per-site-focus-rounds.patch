+// Time spent on websites (counted on this device only) and focus rounds that
+// shut chosen sites for a while. Created by Helium++.
+
+#ifndef CHROME_BROWSER_HELIUM_TIME_HELIUM_TIME_H_
+#define CHROME_BROWSER_HELIUM_TIME_HELIUM_TIME_H_
+
+#include <stdint.h>
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/time/time.h"
+
+class GURL;
+class Profile;
+
+namespace content {
+class NavigationThrottleRegistry;
+}
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace helium_time {
+
+inline constexpr char kEnabledPref[] = "helium.time.enabled";
+// {"YYYY-MM-DD": {"site": seconds}}, local days, last 7 kept.
+inline constexpr char kDaysPref[] = "helium.time.days";
+inline constexpr char kFocusSitesPref[] = "helium.focus_round.sites";
+inline constexpr char kFocusUntilPref[] = "helium.focus_round.until";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// Starts the browser-wide 15-second counter. Call once after startup.
+void StartTracking();
+
+// Registrable domain of |url| ("mail.google.com" -> "google.com"), else host.
+std::string SiteFor(const GURL& url);
+
+// "https://www.YouTube.com/x" -> "youtube.com"; "" when it is not a host.
+std::string NormalizeSite(const std::string& input);
+
+// Today's seconds per site, biggest first.
+std::vector<std::pair<std::string, int64_t>> TimeToday(Profile* profile);
+void ResetToday(Profile* profile);
+// "Forget this site": drops |site| from every day.
+void ForgetSite(Profile* profile, const std::string& site);
+// Clearing history: drops every day from |begin|'s day on (null = all).
+void ClearSince(Profile* profile, base::Time begin);
+
+std::vector<std::string> FocusSites(Profile* profile);
+void SetFocusSites(Profile* profile, const std::vector<std::string>& sites);
+// Null when no round is running.
+base::Time FocusUntil(Profile* profile);
+// Starts a round and reloads open tabs on the shut sites so they close too.
+void StartFocus(Profile* profile, base::TimeDelta length);
+void StopFocus(Profile* profile);
+
+// Adds the throttle that shows the "closed for focus" page.
+void MaybeAddFocusThrottle(content::NavigationThrottleRegistry& registry);
+
+}  // namespace helium_time
+
+#endif  // CHROME_BROWSER_HELIUM_TIME_HELIUM_TIME_H_
