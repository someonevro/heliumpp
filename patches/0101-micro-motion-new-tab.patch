+/* Micro motion: the page rises in item by item, controls give press feedback. Only transform
+   and opacity (compositor-only, no relayout). Off in performance mode (below). */
+@keyframes rise-in {
+  from {
+    opacity: 0;
+    transform: translateY(12px) scale(0.985);
+  }
+}
+
+#greeting > * {
+  animation: rise-in 560ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
+}
+
+#greeting > :nth-child(2) { animation-delay: 50ms; }
+
+#greeting > :nth-child(3) { animation-delay: 100ms; }
+
+#greeting > :nth-child(4) { animation-delay: 150ms; }
+
+#greeting > :nth-child(5) { animation-delay: 190ms; }
+
+#greeting > :nth-child(n+6) { animation-delay: 230ms; }
+
+#privacySwitch button:active,
+#performanceSwitch:active {
+  transform: scale(0.94);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  #content * {
+    animation: none !important;
+    transition: none !important;
+  }
+}
