+// Applies the pref when Settings flips it. Profile user data can outlive the
+// PrefService, so the registrar is dropped when the profile starts shutting down.
+class PerformanceModeWatcher : public base::SupportsUserData::Data,
+                               public ProfileObserver {
+ public:
+  explicit PerformanceModeWatcher(Profile* profile) {
+    observation_.Observe(profile);
+    registrar_.Init(profile->GetPrefs());
+    registrar_.Add(kPerformanceModePref,
+                   base::BindRepeating(&SyncPerformanceMode, profile));
+  }
+
+  void OnProfileWillBeDestroyed(Profile*) override {
+    registrar_.RemoveAll();
+    observation_.Reset();
+  }
+
+ private:
+  PrefChangeRegistrar registrar_;
+  base::ScopedObservation<Profile, ProfileObserver> observation_{this};
+};
+
+constexpr char kPerfWatcherKey[] = "helium_performance_mode_watcher";
+
+void SetPerformanceMode(Profile* profile, bool enabled) {
+  profile->GetPrefs()->SetBoolean(kPerformanceModePref, enabled);
+  SyncPerformanceMode(profile);  // no-op when the watcher already ran it
