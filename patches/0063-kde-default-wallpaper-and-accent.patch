+std::string ParseIniValue(const std::string& ini, const std::string& group,
+                          const std::string& key) {
+  const std::string header = "[" + group + "]";
+  bool in_group = false;
+  for (const std::string& line : Lines(ini)) {
+    if (!line.empty() && line.front() == '[') {
+      in_group = line == header;
+    } else if (in_group && StartsWith(line, key)) {
+      std::string rest = Trim(line.substr(key.size()));
+      if (!rest.empty() && rest.front() == '=') return Trim(rest.substr(1));
+    }
+  }
+  return "";
+}
+
+int ParseKdeRgb(const std::string& value) {
+  int rgb = 0, parts = 0;
+  std::istringstream in(value);
+  for (std::string part; std::getline(in, part, ',');) {
+    part = Trim(part);
+    if (part.empty() || part.size() > 3 ||
+        part.find_first_not_of("0123456789") != std::string::npos) return -1;
+    const int v = std::stoi(part);
+    if (v > 255) return -1;
+    if (++parts <= 3) rgb = rgb << 8 | v;
+  }
+  return parts == 3 || parts == 4 ? rgb : -1;
+}
