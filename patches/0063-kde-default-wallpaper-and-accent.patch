+// $XDG_DATA_HOME, then $XDG_DATA_DIRS (spec defaults when unset).
+std::vector<base::FilePath> DataDirs() {
+  auto env = base::Environment::Create();
+  std::optional<std::string> home = env->GetVar("XDG_DATA_HOME");
+  std::vector<base::FilePath> dirs = {
+      home && !home->empty() ? base::FilePath(*home)
+                             : base::GetHomeDir().Append(".local/share")};
+  std::string system = env->GetVar("XDG_DATA_DIRS").value_or("");
+  for (const std::string& d :
+       base::SplitString(system.empty() ? "/usr/local/share:/usr/share" : system,
+                         ":", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    dirs.emplace_back(d);
+  }
+  return dirs;
+}
+
+// A kdeglobals value: the user's file, then the distribution's /etc/xdg one.
+std::string KdeGlobal(const std::string& group, const std::string& key) {
+  for (const base::FilePath& file :
+       {ConfigHome().Append("kdeglobals"), base::FilePath("/etc/xdg/kdeglobals")}) {
+    std::string ini;
+    if (base::ReadFileToString(file, &ini)) {
+      std::string value =
+          helium_theme::wallpaper::ParseIniValue(ini, group, key);
+      if (!value.empty()) {
+        return value;
+      }
+    }
+  }
+  return std::string();
+}
+
+// KDE's accent: the user's AccentColor, else the colour scheme's selection
+// colour, which Plasma uses as the accent when none is set.
+std::optional<SkColor> KdeAccentColor() {
+  int rgb = helium_theme::wallpaper::ParseKdeRgb(KdeGlobal("General", "AccentColor"));
+  if (rgb < 0) {
+    rgb = helium_theme::wallpaper::ParseKdeRgb(
+        KdeGlobal("Colors:Selection", "BackgroundNormal"));
+  }
+  if (rgb < 0) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF);
+}
+
+// Wallpaper Plasma shows when the user never picked one (no Image= in
+// appletsrc), same order as Plasma's libkworkspace/defaultwallpaper.cpp: the
+// global theme's contents/defaults [Wallpaper] Image=, else "Next".
+// shortcut: skips Plasma's middle step (the Plasma Style's wallpaper); add it if
+// a distro relies on that.
+base::FilePath KdeDefaultWallpaper() {
+  std::string laf = KdeGlobal("KDE", "LookAndFeelPackage");
+  if (laf.empty()) {
+    laf = "org.kde.breeze.desktop";
+  }
+  const std::vector<base::FilePath> dirs = DataDirs();
+  std::string image;
+  for (const base::FilePath& dir : dirs) {
+    std::string ini;
+    if (base::ReadFileToString(
+            dir.Append("plasma/look-and-feel").Append(laf).Append("contents/defaults"),
+            &ini)) {
+      image = helium_theme::wallpaper::ParseIniValue(ini, "Wallpaper", "Image");
+      break;
+    }
+  }
+  if (image.empty()) {
+    image = "Next";
+  }
+  if (image.starts_with("/")) {
+    return base::FilePath(image);
+  }
+  for (const base::FilePath& dir : dirs) {
+    base::FilePath package = dir.Append("wallpapers").Append(image);
+    if (base::PathExists(package)) {
+      return package;
+    }
+  }
+  return base::FilePath();
+}
