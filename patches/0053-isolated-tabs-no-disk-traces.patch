+bool IsIsolatedWebContents(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  content::SiteInstance* site_instance = contents->GetSiteInstance();
+  return site_instance && contents->GetBrowserContext()
+                                  ->GetStoragePartition(site_instance)
+                                  ->GetConfig()
+                                  .partition_domain() == "heliumisolated";
+}
