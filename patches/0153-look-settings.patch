+   tabs). Everything else is shared with the default look. */
+:host([classic]) .nav {
+  margin: 0;
+}
+
+.dots {
+  display: flex;
+  gap: 7px;
+  margin-inline-end: auto;
+}
+
+.dot {
+  background: color-mix(in srgb, var(--hp-ink) 22%, transparent);
+  border-radius: 50%;
+  color: transparent;
+  display: grid;
+  height: 12px;
+  place-items: center;
+  width: 12px;
+}
+
+.dot.close {
+  background: var(--hp-danger);
+}
+
+.dot .i {
+  height: 8px;
+  stroke-width: 2.6;
+  width: 8px;
+}
+
+.dots:hover .dot {
+  color: color-mix(in srgb, black 60%, transparent);
+}
+
+:host([classic]) .scroll {
+  margin-top: var(--hp-space-2);
+}
+
+:host([classic]) .tab {
+  border-radius: var(--hp-radius-tab);
+  font-weight: inherit;
+  gap: 9px;
+  height: var(--hp-row);
+  letter-spacing: normal;
+  padding: 0 4px 0 9px;
+}
+
+:host([classic]) .tab[aria-selected='true'] {
+  background: var(--hp-selected);
+  box-shadow: 0 1px 2px var(--hp-shade-near), 0 0 0 1px var(--hp-edge) inset;
+  font-weight: inherit;
+}
+
+:host([classic]) .t {
+  mask-image: none;
+  text-overflow: ellipsis;
+}
+
+.newtab-row {
+  align-items: center;
+  border-radius: var(--hp-radius-tab);
+  color: var(--hp-ink-2);
+  display: flex;
+  gap: 9px;
+  height: var(--hp-row);
+  margin-top: 2px;
+  padding: 0 9px;
+  width: 100%;
+}
+
+.newtab-row:hover {
+  background: var(--hp-hover);
+  color: var(--hp-ink);
+}
+
+.newtab-row kbd {
+  color: var(--hp-ink-3);
+  font: 500 var(--hp-text-xs) var(--hp-font);
+  margin-inline-start: auto;
+}
+
+@container (max-width: 120px) {
+  .dots,
+  .newtab-row span,
+  .newtab-row kbd {
+    display: none;
+  }
+
+  .newtab-row {
+    justify-content: center;
+    padding: 0;
+  }
+}
