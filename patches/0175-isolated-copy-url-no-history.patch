+namespace {
+// Helium++: links copied from incognito or isolated tabs stay out of clipboard
+// history, like the pages' own copies (0161).
+bool KeepOutOfClipboardHistory(content::WebContents* web_contents) {
+  return web_contents &&
+         (web_contents->GetBrowserContext()->IsOffTheRecord() ||
+          helium_privacy_mode::IsIsolatedWebContents(web_contents));
+}
+}  // namespace
