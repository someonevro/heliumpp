+  // Arrow keys move focus between tab rows and folder headers (in the order
+  // shown); Enter/Space then activates (onTabKeydown_).
+  protected onListKeydown_(e: KeyboardEvent) {
+    if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) {
+      return;
+    }
+    const items = [...this.shadowRoot.querySelectorAll<HTMLElement>(
+        '.scroll .tab, .scroll .folder > .head')];
+    const i = items.indexOf(this.shadowRoot.activeElement as HTMLElement);
+    if (i < 0) {
+      return;
+    }
+    e.preventDefault();
+    const last = items.length - 1;
+    const next = e.key === 'Home' ? 0 :
+        e.key === 'End'           ? last :
+        Math.min(last, Math.max(0, i + (e.key === 'ArrowDown' ? 1 : -1)));
+    items[next]!.focus();
+  }
