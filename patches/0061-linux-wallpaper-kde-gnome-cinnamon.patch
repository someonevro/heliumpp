@@ -0,0 +1,168 @@
+#include "chrome/browser/helium_theme/wallpaper_config_parsers.h"
+
+#include <cctype>
+#include <sstream>
+#include <utility>
+#include <vector>
+
+namespace helium_theme::wallpaper {
+namespace {
+
+std::string Trim(const std::string& s) {
+  size_t b = 0, e = s.size();
+  while (b < e && std::isspace(static_cast<unsigned char>(s[b]))) ++b;
+  while (e > b && std::isspace(static_cast<unsigned char>(s[e - 1]))) --e;
+  return s.substr(b, e - b);
+}
+
+std::vector<std::string> Lines(const std::string& text) {
+  std::vector<std::string> lines;
+  std::istringstream in(text);
+  for (std::string line; std::getline(in, line);) lines.push_back(Trim(line));
+  return lines;
+}
+
+bool StartsWith(const std::string& s, const std::string& prefix) {
+  return s.compare(0, prefix.size(), prefix) == 0;
+}
+
+int HexValue(char c) {
+  if (c >= '0' && c <= '9') return c - '0';
+  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+  return -1;
+}
+
+std::string PercentDecode(const std::string& s) {
+  std::string out;
+  for (size_t i = 0; i < s.size(); ++i) {
+    if (s[i] == '%' && i + 2 < s.size() && HexValue(s[i + 1]) >= 0 &&
+        HexValue(s[i + 2]) >= 0) {
+      out += static_cast<char>(HexValue(s[i + 1]) * 16 + HexValue(s[i + 2]));
+      i += 2;
+    } else {
+      out += s[i];
+    }
+  }
+  return out;
+}
+
+// "file:///a/b.jpg" or "/a/b.jpg" -> "/a/b.jpg"; anything else (http:, colors) -> "".
+std::string UriToPath(const std::string& value) {
+  std::string v = Trim(value);
+  if (StartsWith(v, "file://")) return PercentDecode(v.substr(7));
+  if (StartsWith(v, "/") || StartsWith(v, "~/")) return v;
+  return "";
+}
+
+std::string Unquote(std::string v) {
+  v = Trim(v);
+  if (v.size() >= 2 && (v.front() == '\'' || v.front() == '"') &&
+      v.back() == v.front()) {
+    v = v.substr(1, v.size() - 2);
+  }
+  return v;
+}
+
+}  // namespace
+
+std::string ParseGSettingsValue(const std::string& output) {
+  // Output is a GVariant string: 'file:///x.jpg' (possibly with a type prefix).
+  return UriToPath(Unquote(output));
+}
+
+std::string ParseKdeAppletsrc(const std::string& ini) {
+  bool in_image_section = false;
+  for (const std::string& line : Lines(ini)) {
+    if (!line.empty() && line.front() == '[') {
+      in_image_section =
+          line.find("[Wallpaper][org.kde.image][General]") != std::string::npos;
+    } else if (in_image_section && StartsWith(line, "Image=")) {
+      std::string path = UriToPath(line.substr(6));
+      if (!path.empty()) return path;
+    }
+  }
+  return "";
+}
+
+std::string ParseXfceDesktopXml(const std::string& xml) {
+  const std::string key = "name=\"last-image\"";
+  size_t at = xml.find(key);
+  while (at != std::string::npos) {
+    size_t v = xml.find("value=\"", at);
+    size_t end_of_tag = xml.find('>', at);
+    if (v != std::string::npos && v < end_of_tag) {
+      v += 7;
+      std::string value = xml.substr(v, xml.find('"', v) - v);
+      for (const auto& [from, to] : std::vector<std::pair<std::string, std::string>>{
+               {"&amp;", "&"}, {"&lt;", "<"}, {"&gt;", ">"}, {"&quot;", "\""},
+               {"&apos;", "'"}}) {
+        for (size_t p; (p = value.find(from)) != std::string::npos;)
+          value.replace(p, from.size(), to);
+      }
+      std::string path = UriToPath(value);
+      if (!path.empty()) return path;
+    }
+    at = xml.find(key, at + key.size());
+  }
+  return "";
+}
+
+std::string ParseFehbg(const std::string& script) {
+  for (const std::string& line : Lines(script)) {
+    if (line.find("feh") == std::string::npos) continue;
+    size_t close = line.rfind('\'');
+    if (close == std::string::npos || close == 0) continue;
+    size_t open = line.rfind('\'', close - 1);
+    if (open == std::string::npos) continue;
+    std::string path = UriToPath(line.substr(open + 1, close - open - 1));
+    if (!path.empty()) return path;
+  }
+  return "";
+}
+
+std::string ParseNitrogen(const std::string& cfg) {
+  for (const std::string& line : Lines(cfg)) {
+    if (StartsWith(line, "file=")) {
+      std::string path = UriToPath(line.substr(5));
+      if (!path.empty()) return path;
+    }
+  }
+  return "";
+}
+
+std::string ParseSwayConfig(const std::string& config) {
+  for (const std::string& line : Lines(config)) {
+    if (!StartsWith(line, "output")) continue;
+    size_t bg = line.find(" bg ");
+    if (bg == std::string::npos) continue;
+    std::istringstream rest(line.substr(bg + 4));
+    std::string token;
+    rest >> token;
+    std::string path = UriToPath(Unquote(token));  // "#rrggbb solid_color" -> ""
+    if (!path.empty()) return path;
+  }
+  return "";
+}
+
+std::string ParseHyprpaper(const std::string& config) {
+  for (const std::string& line : Lines(config)) {
+    size_t eq = line.find('=');
+    if (eq == std::string::npos) continue;
+    std::string key = Trim(line.substr(0, eq)), value = Trim(line.substr(eq + 1));
+    if (key == "wallpaper") {
+      size_t comma = value.find(',');
+      if (comma != std::string::npos) value = Trim(value.substr(comma + 1));
+      // Newer syntax allows ",<path>,fit"; keep only the path part.
+      size_t more = value.find(',');
+      if (more != std::string::npos) value = Trim(value.substr(0, more));
+    } else if (key != "path" && key != "preload") {
+      continue;
+    }
+    std::string path = UriToPath(value);
+    if (!path.empty()) return path;
+  }
+  return "";
+}
+
+}  // namespace helium_theme::wallpaper
