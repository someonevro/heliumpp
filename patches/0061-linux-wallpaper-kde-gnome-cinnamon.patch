+// Pure text parsers that find the current wallpaper path in the config files and
+// command output of Linux desktops. std-only so they can be tested without a
+// Chromium build (scripts/test_wallpaper_parsers.sh). All return "" when no
+// wallpaper path is found. A leading "~/" is left for the caller to expand.
+#ifndef CHROME_BROWSER_HELIUM_THEME_WALLPAPER_CONFIG_PARSERS_H_
+#define CHROME_BROWSER_HELIUM_THEME_WALLPAPER_CONFIG_PARSERS_H_
+
+#include <string>
+
+namespace helium_theme::wallpaper {
+
+// `gsettings get ...picture-uri` output, e.g. 'file:///usr/share/a%20b.jpg'.
+std::string ParseGSettingsValue(const std::string& output);
+// ~/.config/plasma-org.kde.plasma.desktop-appletsrc (first org.kde.image Image=).
+std::string ParseKdeAppletsrc(const std::string& ini);
+// xfce4-desktop.xml (first "last-image" property).
+std::string ParseXfceDesktopXml(const std::string& xml);
+// ~/.fehbg (last quoted path on the feh line).
+std::string ParseFehbg(const std::string& script);
+// ~/.config/nitrogen/bg-saved.cfg (first file=).
+std::string ParseNitrogen(const std::string& cfg);
+// sway config: `output <name> bg <path> <mode>`.
+std::string ParseSwayConfig(const std::string& config);
+// hyprpaper.conf: `wallpaper = mon,path`, `path = ...` or `preload = ...`.
+std::string ParseHyprpaper(const std::string& config);
+
+}  // namespace helium_theme::wallpaper
+
+#endif  // CHROME_BROWSER_HELIUM_THEME_WALLPAPER_CONFIG_PARSERS_H_
