+#if BUILDFLAG(IS_LINUX)
+enum class LinuxDesktop { kOther, kKde, kGnome, kCinnamon };
+
+// From XDG_CURRENT_DESKTOP, a colon-separated list such as "ubuntu:GNOME".
+LinuxDesktop DetectLinuxDesktop() {
+  std::string value =
+      base::Environment::Create()->GetVar("XDG_CURRENT_DESKTOP").value_or("");
+  for (std::string_view name : base::SplitStringPiece(
+           base::ToUpperASCII(value), ":", base::TRIM_WHITESPACE,
+           base::SPLIT_WANT_NONEMPTY)) {
+    if (name == "KDE") return LinuxDesktop::kKde;
+    if (name == "X-CINNAMON" || name == "CINNAMON") return LinuxDesktop::kCinnamon;
+    if (name == "GNOME" || name == "UNITY" || name == "BUDGIE") {
+      return LinuxDesktop::kGnome;
+    }
+  }
+  return LinuxDesktop::kOther;
+}
+
+base::FilePath ConfigHome() {
+  std::optional<std::string> dir =
+      base::Environment::Create()->GetVar("XDG_CONFIG_HOME");
+  return dir && !dir->empty() ? base::FilePath(*dir)
+                              : base::GetHomeDir().Append(".config");
+}
+
+base::FilePath KdeWallpaperConfig() {
+  return ConfigHome().Append("plasma-org.kde.plasma.desktop-appletsrc");
+}
+
+// GNOME and Cinnamon keep settings in dconf; every gsettings write changes this file.
+base::FilePath DconfUserDb() {
+  return ConfigHome().Append("dconf/user");
+}
+
+base::FilePath ExpandHome(const std::string& path) {
+  if (path.starts_with("~/")) {
+    return base::GetHomeDir().Append(path.substr(2));
+  }
+  return base::FilePath(path);
+}
+
+std::string GSettingsGet(const char* schema, const char* key) {
+  std::string output;
+  if (!base::GetAppOutput({"gsettings", "get", schema, key}, &output)) {
+    return std::string();
+  }
+  return output;
+}
+
+// KDE's default wallpapers are folders (.../Next); the images are in
+// contents/images. Picks the biggest file, which is the highest resolution.
+base::FilePath ResolveWallpaperPackage(const base::FilePath& path) {
+  if (!base::DirectoryExists(path)) {
+    return path;
+  }
+  base::FilePath best;
+  int64_t best_size = 0;
+  base::FileEnumerator files(path.Append("contents/images"), false,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath f = files.Next(); !f.empty(); f = files.Next()) {
+    if (files.GetInfo().GetSize() > best_size) {
+      best_size = files.GetInfo().GetSize();
+      best = f;
+    }
+  }
+  return best;
+}
+
+// Wallpaper of the running desktop environment. Runs on a blocking thread.
+// shortcut: only KDE, GNOME and Cinnamon; other desktops fall back to the accent.
+base::FilePath LinuxDesktopWallpaper() {
+  std::string path;
+  switch (DetectLinuxDesktop()) {
+    case LinuxDesktop::kKde: {
+      std::string ini;
+      if (base::ReadFileToString(KdeWallpaperConfig(), &ini)) {
+        path = helium_theme::wallpaper::ParseKdeAppletsrc(ini);
+      }
+      break;
+    }
+    case LinuxDesktop::kGnome:
+      // The dark-mode wallpaper is only used when the desktop is in dark mode.
+      if (GSettingsGet("org.gnome.desktop.interface", "color-scheme")
+              .find("prefer-dark") != std::string::npos) {
+        path = helium_theme::wallpaper::ParseGSettingsValue(
+            GSettingsGet("org.gnome.desktop.background", "picture-uri-dark"));
+      }
+      if (path.empty()) {
+        path = helium_theme::wallpaper::ParseGSettingsValue(
+            GSettingsGet("org.gnome.desktop.background", "picture-uri"));
+      }
+      break;
+    case LinuxDesktop::kCinnamon:
+      path = helium_theme::wallpaper::ParseGSettingsValue(
+          GSettingsGet("org.cinnamon.desktop.background", "picture-uri"));
+      break;
+    case LinuxDesktop::kOther:
+      break;
+  }
+  return path.empty() ? base::FilePath()
+                      : ResolveWallpaperPackage(ExpandHome(path));
+}
+
+// Omarchy's wallpaper when present, otherwise the desktop environment's.
+base::FilePath LinuxWallpaperPath() {
+  base::FilePath omarchy = OmarchyCurrentDir().Append("background");
+  return base::PathExists(omarchy) ? omarchy : LinuxDesktopWallpaper();
+}
