+void LocationBarView::SetSidebarStyle(bool enabled) {
+  if (sidebar_style_ == enabled) {
+    return;
+  }
+  sidebar_style_ = enabled;
+  UpdateCopyLinkButton();
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+// The copy-link button shows only while the pointer is over the bar, the bar is
+// in the sidebar style, and the user is not typing.
+void LocationBarView::UpdateCopyLinkButton() {
+  if (!copy_link_button_) {
+    return;
+  }
+  const bool show = sidebar_style_ && IsMouseHovered() &&
+                    !omnibox_view_->HasFocus() &&
+                    !omnibox_controller_->IsPopupOpen();
+  if (copy_link_button_->GetVisible() != show) {
+    copy_link_button_->SetVisible(show);
+    InvalidateLayout();
+  }
+}
+
+void LocationBarView::OnCopyLinkPressed() {
+  if (!browser_) {
+    return;
+  }
+  chrome::ExecuteCommand(browser_, IDC_COPY_URL);
+  // Brief confirmation: swap the icon to a check mark.
+  views::SetImageFromVectorIconWithColor(
+      copy_link_button_, kCheckIcon, 16,
+      {ui::kColorIcon, ui::kColorIconDisabled});
+  copy_link_button_->SetTooltipText(u"Link copied");
+  copy_feedback_timer_.Start(
+      FROM_HERE, base::Seconds(1.5),
+      base::BindOnce(&LocationBarView::ResetCopyLinkIcon,
+                     base::Unretained(this)));
+}
+
+void LocationBarView::ResetCopyLinkIcon() {
+  views::SetImageFromVectorIconWithColor(
+      copy_link_button_, vector_icons::kContentCopyIcon, 16,
+      {ui::kColorIcon, ui::kColorIconDisabled});
+  copy_link_button_->SetTooltipText(u"Copy link");
+}
