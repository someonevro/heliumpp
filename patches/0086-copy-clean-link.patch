+// Query parameters that only record who shared or clicked a link (for "Copy clean link").
+constexpr auto kTrackingParams = base::MakeFixedFlatSet<std::string_view>(
+    {"fbclid",      "gclid",     "gclsrc",      "dclid",      "gbraid",
+     "wbraid",      "msclkid",   "mc_cid",      "mc_eid",     "igshid",
+     "igsh",        "yclid",     "ysclid",      "twclid",     "ttclid",
+     "li_fat_id",   "_hsenc",    "_hsmi",       "__hssc",     "__hstc",
+     "__hsfp",      "mkt_tok",   "oly_anon_id", "oly_enc_id", "vero_id",
+     "vero_conv",   "_openstat", "wickedid",    "rb_clickid", "s_cid",
+     "srsltid",     "epik",      "_gl",         "ref_src",    "ref_url"});
+// Prefixes of whole tracking families: utm_source, utm_medium, ... (and Matomo/Piwik's).
+constexpr std::string_view kTrackingPrefixes[] = {"utm_", "mtm_", "pk_"};
+
+bool IsTrackingParam(std::string_view host, std::string_view key) {
+  const std::string lower = base::ToLowerASCII(key);
+  if (kTrackingParams.contains(lower)) {
+    return true;
+  }
+  for (std::string_view prefix : kTrackingPrefixes) {
+    if (lower.starts_with(prefix)) {
+      return true;
+    }
+  }
+  // "si" is a share id on YouTube and Spotify but may mean anything elsewhere.
+  return lower == "si" &&
+         (host == "youtu.be" || host == "open.spotify.com" ||
+          host == "youtube.com" || host.ends_with(".youtube.com"));
+}
+
+// `url` without tracking query parameters; everything else is kept byte for byte.
+GURL StripTrackingParams(const GURL& url) {
+  if (!url.has_query() || !url.SchemeIsHTTPOrHTTPS()) {
+    return url;
+  }
+  std::vector<std::string_view> kept;
+  for (std::string_view part : base::SplitStringPiece(
+           url.query(), "&", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (!IsTrackingParam(url.host(), part.substr(0, part.find('=')))) {
+      kept.push_back(part);
+    }
+  }
+  const std::string query = base::JoinString(kept, "&");
+  GURL::Replacements replacements;
+  if (query.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(query);
+  }
+  return url.ReplaceComponents(replacements);
+}
