+// The sidebar is lit from the top by the theme accent, fading toward the
+// bottom, so it reads as tinted glass without needing compositor blur.
+void VerticalTabStripRegionView::OnPaintBackground(gfx::Canvas* canvas) {
+  BaseTabStripRegionView::OnPaintBackground(canvas);
+  if (zen_mode_floating_style_ || !GetColorProvider()) {
+    return;
+  }
+  const SkColor accent = GetColorProvider()->GetColor(ui::kColorSysPrimary);
+  cc::PaintFlags flags;
+  flags.setShader(gfx::CreateGradientShader(
+      gfx::Point(0, 0), gfx::Point(0, height()), SkColorSetA(accent, 0x30),
+      SkColorSetA(accent, 0x04)));
+  canvas->DrawRect(GetLocalBounds(), flags);
+}
