+// The site "Forget this site" acts on: example.com for www.example.com, the host for IPs.
+std::string SiteOf(const GURL& url) {
+  std::string site = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  return site.empty() ? std::string(url.host()) : site;
+}
+
+// Deletes every history URL on `site` (any subdomain or scheme). Walks the URL
+// table itself: QueryHistory skips some rows, like failed HTTPS-upgrade attempts.
+class DeleteSiteHistoryTask : public history::HistoryDBTask {
+ public:
+  explicit DeleteSiteHistoryTask(std::string site) : site_(std::move(site)) {}
+
+  bool RunOnDBThread(history::HistoryBackend* backend,
+                     history::HistoryDatabase* db) override {
+    history::URLDatabase::URLEnumerator enumerator;
+    history::URLRow row;
+    std::vector<GURL> urls;
+    if (db->InitURLEnumeratorForEverything(&enumerator)) {
+      while (enumerator.GetNextURL(&row)) {
+        if (row.url().DomainIs(site_)) {
+          urls.push_back(row.url());
+        }
+      }
+    }
+    if (!urls.empty()) {
+      backend->DeleteURLs(urls);
+    }
+    return true;
+  }
+  void DoneRunOnMainThread() override {}
+
+ private:
+  const std::string site_;
+};
+
+// Deletes the cookies, storage, cache and history of a site (all its
+// subdomains), then leaves the site for the new tab page: reloading would be a new
+// visit that stores it all again. Deletes itself.
+class SiteForgetter : public content::BrowsingDataRemover::Observer {
+ public:
+  static void Start(content::WebContents* contents, const GURL& url) {
+    new SiteForgetter(contents, SiteOf(url));
+  }
+
+ private:
+  SiteForgetter(content::WebContents* contents, const std::string& site)
+      : contents_(contents->GetWeakPtr()) {
+    Profile* profile =
+        Profile::FromBrowserContext(contents->GetBrowserContext());
+    // The remover ignores filters for history and would wipe all of it, so the
+    // site's entries are picked out here.
+    if (history::HistoryService* history =
+            HistoryServiceFactory::GetForProfile(
+                profile, ServiceAccessType::EXPLICIT_ACCESS)) {
+      static base::NoDestructor<base::CancelableTaskTracker> tracker;
+      history->ScheduleDBTask(FROM_HERE,
+                              std::make_unique<DeleteSiteHistoryTask>(site),
+                              tracker.get());
+    }
+    auto filter = content::BrowsingDataFilterBuilder::Create(
+        content::BrowsingDataFilterBuilder::Mode::kDelete);
+    filter->AddRegisterableDomain(site);
+    profile->GetBrowsingDataRemover()->RemoveWithFilterAndReply(
+        base::Time(), base::Time::Max(),
+        // Content settings (permissions) can't be removed per site; page info
+        // has its own reset for those.
+        chrome_browsing_data_remover::DATA_TYPE_SITE_DATA |
+            content::BrowsingDataRemover::DATA_TYPE_CACHE,
+        content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB |
+            content::BrowsingDataRemover::ORIGIN_TYPE_PROTECTED_WEB,
+        std::move(filter), this);
+  }
+
+  void OnBrowsingDataRemoverDone(uint64_t failed_data_types) override {
+    if (contents_) {
+      contents_->GetController().LoadURL(
+          GURL(chrome::kChromeUINewTabURL), content::Referrer(),
+          ui::PAGE_TRANSITION_AUTO_TOPLEVEL, std::string());
+    }
+    delete this;
+  }
+
+  base::WeakPtr<content::WebContents> contents_;
+};
+
