+int ParseGnomeAccent(const std::string& output) {
+  // GNOME 47's named accents (libadwaita's colours for each name).
+  static const std::pair<const char*, int> kAccents[] = {
+      {"blue", 0x3584e4},   {"teal", 0x2190a4}, {"green", 0x3a944a},
+      {"yellow", 0xc88800}, {"orange", 0xed5b00}, {"red", 0xe62d42},
+      {"pink", 0xd56199},   {"purple", 0x9141ac}, {"slate", 0x6f8396}};
+  const std::string name = Unquote(output);
+  for (const auto& [accent, rgb] : kAccents) {
+    if (name == accent) return rgb;
+  }
+  return -1;
+}
