+// Monitors plugged in now, by their X11/xrandr names (DRM "card1-HDMI-A-1" gives
+// "HDMI-A-1" and "HDMI-1"; drivers differ in which one X uses).
+std::vector<std::string> ConnectedMonitors() {
+  std::vector<std::string> names;
+  base::FileEnumerator connectors(base::FilePath("/sys/class/drm"), false,
+                                  base::FileEnumerator::DIRECTORIES |
+                                      base::FileEnumerator::SHOW_SYM_LINKS);
+  for (base::FilePath dir = connectors.Next(); !dir.empty(); dir = connectors.Next()) {
+    const std::string base_name = dir.BaseName().value();
+    const size_t dash = base_name.find('-');
+    std::string status;
+    if (!base_name.starts_with("card") || dash == std::string::npos ||
+        !base::ReadFileToString(dir.Append("status"), &status) ||
+        !status.starts_with("connected")) {
+      continue;
+    }
+    std::string name = base_name.substr(dash + 1);
+    names.push_back(name);
+    base::ReplaceFirstSubstringAfterOffset(&name, 0, "-A-", "-");
+    names.push_back(name);
+  }
+  return names;
 }
 
