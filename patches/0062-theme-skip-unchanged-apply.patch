+// True if the theme is exactly what kLastAppliedPref says we applied.
+bool ThemeShowsLastApplied(Profile* profile) {
+  ThemeService* theme = ThemeServiceFactory::GetForProfile(profile);
+  const int last = profile->GetPrefs()->GetInteger(kLastAppliedPref);
+  if (last == 0) {
+    return theme->GetIsGrayscale();
+  }
+  return !theme->GetIsGrayscale() &&
+         theme->GetUserColor() == static_cast<SkColor>(last);
+}
