+void VerticalTabStripFooter::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  strip_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  strip_menu_model_->AddItem(IDC_CREATE_NEW_TAB_GROUP, u"New folder");
+  strip_menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  strip_menu_model_->AddItem(IDC_SHOW_HISTORY, u"History");
+  strip_menu_model_->AddItem(IDC_SHOW_BOOKMARK_MANAGER, u"Bookmarks");
+  strip_menu_runner_ = std::make_unique<views::MenuRunner>(
+      strip_menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  strip_menu_runner_->RunMenuAt(source->GetWidget(), nullptr,
+                                gfx::Rect(point, gfx::Size()),
+                                views::MenuAnchorPosition::kTopLeft,
+                                source_type);
+}
