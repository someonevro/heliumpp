+
+namespace {
+constexpr char kWebSidebarSwitch[] = "helium-web-sidebar";
+}  // namespace
+
+HeliumSidebarWebView::HeliumSidebarWebView(BrowserWindowInterface* browser)
+    : views::WebView(browser->GetProfile()), browser_(browser) {
+  contents_wrapper_ =
+      std::make_unique<WebUIContentsWrapperT<heliumpp_sidebar::SidebarUI>>(
+          GURL(chrome::kChromeUIHeliumSidebarURL), browser_->GetProfile(),
+          IDS_HELIUM_SIDEBAR_NAME, /*esc_closes_ui=*/false);
+  contents_wrapper_->SetHost(weak_factory_.GetWeakPtr());
+  // Before the page binds its interfaces: they look the window up here.
+  webui::SetBrowserWindowInterface(contents_wrapper_->web_contents(), browser_);
+  // See-through, so the window's glass or frame colour shows behind the page.
+  contents_wrapper_->web_contents()->SetPageBaseBackgroundColor(
+      SK_ColorTRANSPARENT);
+  SetWebContents(contents_wrapper_->web_contents());
+  contents_wrapper_->web_contents()->WasShown();
+}
+
+HeliumSidebarWebView::~HeliumSidebarWebView() {
+  contents_wrapper_->web_contents()->WasHidden();
+  contents_wrapper_->SetHost(nullptr);
+}
+
+// static
+bool HeliumSidebarWebView::IsEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(kWebSidebarSwitch);
+}
+
+void HeliumSidebarWebView::ShowUI() {
+  SetVisible(true);
+}
+
+void HeliumSidebarWebView::CloseUI() {}
+
+bool HeliumSidebarWebView::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  return unhandled_keyboard_event_handler_.HandleKeyboardEvent(
+      event, GetFocusManager());
+}
+
+BEGIN_METADATA(HeliumSidebarWebView)
+END_METADATA
