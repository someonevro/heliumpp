+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {ColorChangeUpdater} from 'chrome://resources/cr_components/color_change_listener/colors_css_updater.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import type {Container, Tab, TabGroup} from '/tab_strip_api/tab_strip_api_data_model.mojom-webui.js';
+import {TabsObserverReceiver} from '/tab_strip_api/tab_strip_api.mojom-webui.js';
+
+import {getCss} from './app.css.js';
+import {getHtml} from './app.html.js';
+import {BrowserProxy} from './browser_proxy.js';
+import {Command} from './heliumpp_sidebar.mojom-webui.js';
+import type {State, Workspace} from './heliumpp_sidebar.mojom-webui.js';
+
+export interface Folder {
+  group: TabGroup;
+  tabs: Tab[];
+}
+
+// One entry of the tab list: a tab, or a folder (tab group) with its tabs.
+export interface Row {
+  tab?: Tab;
+  folder?: Folder;
+  color?: string;
+}
+
+// Fill of each tab group colour id (tab_groups.mojom.Color order).
+const GROUP_COLORS = [
+  '#8e95a3', '#5b8def', '#e5534b', '#e2a93b', '#3fa66b',
+  '#d15fa6', '#9a6bf0', '#3db2c8', '#f08a3d',
+];
+
+export class HeliumSidebarAppElement extends CrLitElement {
+  static get is() {
+    return 'helium-sidebar-app';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      state_: {type: Object},
+      essentials_: {type: Array},
+      rows_: {type: Array},
+      shieldOpen_: {type: Boolean},
+    };
+  }
+
+  protected accessor state_: State|null = null;
+  protected accessor essentials_: Tab[] = [];
+  protected accessor rows_: Row[] = [];
+  protected accessor shieldOpen_: boolean = false;
+
+  protected readonly levels_ = [
+    {id: 'usability', name: 'Usability'},
+    {id: 'medium', name: 'Medium'},
+    {id: 'maximum', name: 'Maximum'},
+  ];
+
+  private proxy_ = BrowserProxy.getInstance();
+  private observer_: TabsObserverReceiver|null = null;
+  private refreshQueued_ = false;
+  // Tab groups by id, for the folder click handler.
+  private groups_ = new Map<string, TabGroup>();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    ColorChangeUpdater.forDocument().start();
+    this.proxy_.callbackRouter.onStateChanged.addListener(
+        (state: State) => this.state_ = state);
+    this.proxy_.handler.getState().then(({state}) => this.state_ = state);
+    this.refresh_();
+  }
+
+  // shortcut: re-reads the whole tab tree (at most once per frame) on any tab
+  // event instead of applying each event; fine for hundreds of tabs.
+  private async refresh_() {
+    const snapshot = await this.proxy_.tabs.getTabs();
+    this.applyTree_(snapshot.tabStrip);
+    // Keep exactly one event stream: the one that follows this snapshot.
+    this.observer_?.$.close();
+    this.observer_ = new TabsObserverReceiver({
+      onTabEvents: () => this.scheduleRefresh_(),
+    });
+    this.observer_.$.bindHandle(snapshot.stream.handle);
+  }
+
+  private scheduleRefresh_() {
+    if (this.refreshQueued_) {
+      return;
+    }
+    this.refreshQueued_ = true;
+    requestAnimationFrame(() => {
+      this.refreshQueued_ = false;
+      this.refresh_();
+    });
+  }
+
+  private applyTree_(root: Container) {
+    const tabsIn = (c: Container): Tab[] => c.children.flatMap(
+        child => child.data.tab ? [child.data.tab] : tabsIn(child));
+    const essentials: Tab[] = [];
+    const rows: Row[] = [];
+    this.groups_.clear();
+    // window > tab strip > pinned / unpinned sections.
+    const sectionsIn = (c: Container): Container[] =>
+        c.data.pinnedTabs || c.data.unpinnedTabs ?
+        [c] :
+        c.children.flatMap(sectionsIn);
+    for (const section of sectionsIn(root)) {
+      if (section.data.pinnedTabs) {
+        essentials.push(...tabsIn(section));
+        continue;
+      }
+      if (!section.data.unpinnedTabs) {
+        continue;
+      }
+      for (const child of section.children) {
+        if (child.data.tab) {
+          rows.push({tab: child.data.tab});
+        } else if (child.data.tabGroup) {
+          const group = child.data.tabGroup;
+          this.groups_.set(group.id, group);
+          rows.push({
+            folder: {group, tabs: tabsIn(child)},
+            color: GROUP_COLORS[group.data.color] || GROUP_COLORS[0],
+          });
+        } else {
+          // Split views: their tabs, one row each.
+          rows.push(...tabsIn(child).map(tab => ({tab})));
+        }
+      }
+    }
+    this.essentials_ = essentials;
+    this.rows_ = rows;
+  }
+
+  // Template helpers.
+  protected workspaces_(): Workspace[] {
+    return this.state_?.workspaces || [];
+  }
+
+  protected isActiveWorkspace_(id: string): boolean {
+    return this.state_?.activeWorkspace === id;
+  }
+
+  protected isLevel_(id: string): boolean {
+    return this.state_?.privacyLevel === id;
+  }
+
+  protected isPerformanceMode_(): boolean {
+    return !!this.state_?.performanceMode;
+  }
+
+  protected levelName_(): string {
+    const level = this.levels_.find(l => this.isLevel_(l.id));
+    return level ? level.name : 'Medium';
+  }
+
+  protected favicon_(tab: Tab): string {
+    return tab.favicon?.dataUrl || 'chrome://favicon2/';
+  }
+
+  private idOf_(e: Event): string {
+    return (e.currentTarget as HTMLElement).dataset['id'] || '';
+  }
+
+  // Tabs.
+  protected onTabClick_(e: Event) {
+    this.proxy_.tabs.activateTab(this.idOf_(e));
+  }
+
+  protected onTabAuxclick_(e: MouseEvent) {
+    if (e.button === 1) {  // middle click closes, as in every browser
+      e.preventDefault();
+      this.proxy_.tabs.closeNodes([this.idOf_(e)]);
+    }
+  }
+
+  protected onTabKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter' || e.key === ' ') {
+      e.preventDefault();
+      this.proxy_.tabs.activateTab(this.idOf_(e));
+    } else if (e.key === 'Delete') {
+      this.proxy_.tabs.closeNodes([this.idOf_(e)]);
+    }
+  }
+
+  protected onCloseClick_(e: Event) {
+    e.stopPropagation();
+    this.proxy_.tabs.closeNodes([this.idOf_(e)]);
+  }
+
+  protected onFolderClick_(e: Event) {
+    const group = this.groups_.get(this.idOf_(e));
+    if (!group) {
+      return;
+    }
+    this.proxy_.tabs.update(
+        {
+          tabGroup: {
+            ...group,
+            data: {...group.data, isCollapsed: !group.data.isCollapsed},
+          },
+        },
+        null);
+  }
+
+  // Workspaces.
+  protected onWorkspaceClick_(e: Event) {
+    this.proxy_.handler.switchWorkspace(this.idOf_(e));
+  }
+
+  protected onAddWorkspaceClick_() {
+    this.proxy_.handler.createWorkspace();
+  }
+
+  // Shield.
+  protected onShieldClick_() {
+    this.shieldOpen_ = !this.shieldOpen_;
+  }
+
+  protected onLevelClick_(e: Event) {
+    this.proxy_.handler.setPrivacyLevel(this.idOf_(e));
+  }
+
+  protected onPerformanceClick_() {
+    this.proxy_.handler.setPerformanceMode(!this.isPerformanceMode_());
+  }
+
+  // Commands.
+  protected onNewTabClick_() {
+    this.proxy_.handler.runCommand(Command.kNewTab);
+  }
+
+  protected onDownloadsClick_() {
+    this.proxy_.handler.runCommand(Command.kDownloads);
+  }
+
+  protected onExtensionsClick_() {
+    this.proxy_.handler.runCommand(Command.kExtensions);
+  }
+
+  protected onSettingsClick_() {
+    this.proxy_.handler.runCommand(Command.kSettings);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'helium-sidebar-app': HeliumSidebarAppElement;
+  }
+}
+
+customElements.define(HeliumSidebarAppElement.is, HeliumSidebarAppElement);
