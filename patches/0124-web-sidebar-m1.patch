+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// The web sidebar's own page handler. Tabs come from tabs_api.mojom
+// (TabStripService); this covers what the tab strip API does not: workspaces,
+// the privacy level and performance mode, and browser commands.
+module heliumpp_sidebar.mojom;
+
+struct Workspace {
+  string id;
+  string name;
+};
+
+struct State {
+  array<Workspace> workspaces;
+  string active_workspace;
+  // "usability", "medium" or "maximum".
+  string privacy_level;
+  bool performance_mode;
+};
+
+enum Command {
+  kNewTab,
+  kNewFolder,
+  kHistory,
+  kBookmarks,
+  kDownloads,
+  kExtensions,
+  kSettings,
+  kFocusLocationBar,
+};
+
+interface PageHandlerFactory {
+  CreatePageHandler(pending_remote<Page> page,
+                    pending_receiver<PageHandler> handler);
+};
+
+// Browser side. Only fixed values cross: ids from GetState and enum commands.
+interface PageHandler {
+  GetState() => (State state);
+  SwitchWorkspace(string id);
+  CreateWorkspace();
+  SetPrivacyLevel(string level);
+  SetPerformanceMode(bool enabled);
+  RunCommand(Command command);
+};
+
+// Page side.
+interface Page {
+  OnStateChanged(State state);
+};
