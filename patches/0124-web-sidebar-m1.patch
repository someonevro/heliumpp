+// Connections to the browser: the tab strip API and our own page handler.
+export class BrowserProxy {
+  readonly tabs: TabStripServiceRemote = TabStripService.getRemote();
+  readonly handler = new PageHandlerRemote();
+  readonly callbackRouter = new PageCallbackRouter();
