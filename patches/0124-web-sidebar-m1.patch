+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/webui/webui_util.h"
+
+namespace heliumpp_sidebar {
+
+SidebarUIConfig::SidebarUIConfig()
+    : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                  chrome::kChromeUIHeliumSidebarHost) {}
+
+SidebarUI::SidebarUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/false) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(),
+      chrome::kChromeUIHeliumSidebarHost);
+  webui::SetupWebUIDataSource(source, kHeliumppSidebarResources,
+                              IDR_HELIUMPP_SIDEBAR_HELIUMPP_SIDEBAR_HTML);
+  // The tab strip API bindings and helpers, served under /tab_strip_api/.
+  source->AddResourcePaths(kTabStripApiResources);
+}
+
+SidebarUI::~SidebarUI() = default;
+
+void SidebarUI::BindInterface(
+    mojo::PendingReceiver<mojom::PageHandlerFactory> receiver) {
+  factory_receiver_.reset();
+  factory_receiver_.Bind(std::move(receiver));
+}
+
+void SidebarUI::BindInterface(
+    mojo::PendingReceiver<tabs_api::mojom::TabStripService> receiver) {
+  // The embedding view sets the window before loading the page.
+  BrowserWindowInterface* browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  TabStripServiceFeature* feature =
+      browser ? TabStripServiceFeature::From(browser) : nullptr;
+  if (feature) {
+    feature->Accept(std::move(receiver));
+  }
+}
+
+void SidebarUI::CreatePageHandler(
+    mojo::PendingRemote<mojom::Page> page,
+    mojo::PendingReceiver<mojom::PageHandler> handler) {
+  BrowserWindowInterface* browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!browser) {
+    return;
+  }
+  page_handler_ = std::make_unique<SidebarPageHandler>(
+      std::move(page), std::move(handler), browser);
+}
+
+WEB_UI_CONTROLLER_TYPE_IMPL(SidebarUI)
+
+}  // namespace heliumpp_sidebar
