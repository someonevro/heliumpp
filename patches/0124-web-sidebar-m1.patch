+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {html, nothing} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {HeliumSidebarAppElement} from './app.js';
+import {ICONS} from './icons.js';
+
+export function getHtml(this: HeliumSidebarAppElement) {
+  // clang-format off
+  return html`
+<nav class="spaces" aria-label="Workspaces">
+  ${this.workspaces_().map(w => html`
+    <button aria-pressed="${this.isActiveWorkspace_(w.id)}" data-id="${w.id}"
+        @click="${this.onWorkspaceClick_}">${w.name}</button>`)}
+  <button class="add" aria-label="New workspace"
+      @click="${this.onAddWorkspaceClick_}">${ICONS.plus}</button>
+</nav>
+
+${this.essentials_.length ? html`
+  <div class="essentials" role="tablist" aria-label="Essentials">
+    ${this.essentials_.map(tab => html`
+      <button class="tile" role="tab" aria-selected="${tab.isActive}"
+          title="${tab.title}" aria-label="${tab.title}" data-id="${tab.id}"
+          @click="${this.onTabClick_}" @auxclick="${this.onTabAuxclick_}">
+        <img class="fav" src="${this.favicon_(tab)}" alt="">
+      </button>`)}
+  </div>` : nothing}
+
+<div class="scroll" role="tablist" aria-label="Tabs">
+  ${this.rows_.map(row => row.folder ? html`
+    <div class="folder" style="--c: ${row.color}">
+      <button class="head" aria-expanded="${!row.folder.group.data.isCollapsed}"
+          data-id="${row.folder.group.id}" @click="${this.onFolderClick_}">
+        <span class="chev">${ICONS.chevron}</span>
+        <span class="swatch"></span>
+        <span class="t">${row.folder.group.data.title || 'Folder'}</span>
+        <span class="count">${row.folder.tabs.length}</span>
+      </button>
+      ${!row.folder.group.data.isCollapsed ? html`
+        <div class="items">
+          ${row.folder.tabs.map(tab => html`
+            <div class="tab" role="tab" tabindex="0"
+                aria-selected="${tab.isActive}" title="${tab.title}"
+                data-id="${tab.id}" @click="${this.onTabClick_}"
+                @auxclick="${this.onTabAuxclick_}"
+                @keydown="${this.onTabKeydown_}">
+              <img class="fav" src="${this.favicon_(tab)}" alt="">
+              <span class="t">${tab.title || tab.url}</span>
+              <button class="icon-btn x" aria-label="Close ${tab.title}"
+                  data-id="${tab.id}" @click="${this.onCloseClick_}">
+                ${ICONS.close}
+              </button>
+            </div>`)}
+        </div>` : nothing}
+    </div>` : html`
+    <div class="tab" role="tab" tabindex="0" aria-selected="${row.tab!.isActive}"
+        title="${row.tab!.title}" data-id="${row.tab!.id}"
+        @click="${this.onTabClick_}" @auxclick="${this.onTabAuxclick_}"
+        @keydown="${this.onTabKeydown_}">
+      <img class="fav" src="${this.favicon_(row.tab!)}" alt="">
+      <span class="t">${row.tab!.title || row.tab!.url}</span>
+      <button class="icon-btn x" aria-label="Close ${row.tab!.title}"
+          data-id="${row.tab!.id}" @click="${this.onCloseClick_}">
+        ${ICONS.close}
+      </button>
+    </div>`)}
+  <button class="newtab" @click="${this.onNewTabClick_}">
+    ${ICONS.plus}<span>New tab</span><kbd>Ctrl T</kbd>
+  </button>
+</div>
+
+${this.shieldOpen_ ? html`
+  <section class="panel" role="dialog" aria-label="Privacy shield">
+    <h2>${ICONS.shield}Privacy level</h2>
+    <div class="seg" role="group" aria-label="Privacy level">
+      ${this.levels_.map(level => html`
+        <button aria-pressed="${this.isLevel_(level.id)}" data-id="${level.id}"
+            @click="${this.onLevelClick_}">${level.name}</button>`)}
+    </div>
+    <div class="toggle-row">
+      <div><strong>Performance mode</strong>
+        <small>Background tabs sleep after 5 minutes</small></div>
+      <button class="switch" role="switch"
+          aria-checked="${this.isPerformanceMode_()}"
+          aria-label="Performance mode"
+          @click="${this.onPerformanceClick_}"></button>
+    </div>
+  </section>` : nothing}
+
+<footer class="foot">
+  <button class="shield" aria-expanded="${this.shieldOpen_}"
+      aria-label="Privacy level: ${this.levelName_()}"
+      @click="${this.onShieldClick_}">
+    ${ICONS.shield}<b>${this.levelName_()}</b>
+  </button>
+  <button class="icon-btn" aria-label="Downloads" title="Downloads"
+      @click="${this.onDownloadsClick_}">${ICONS.download}</button>
+  <button class="icon-btn" aria-label="Extensions" title="Extensions"
+      @click="${this.onExtensionsClick_}">${ICONS.puzzle}</button>
+  <button class="icon-btn" aria-label="Settings" title="Settings"
+      @click="${this.onSettingsClick_}">${ICONS.gear}</button>
+</footer>`;
+  // clang-format on
+}
