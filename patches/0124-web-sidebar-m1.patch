+#include "chrome/browser/ui/webui/heliumpp_sidebar/sidebar_page_handler.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/helium_privacy_mode/helium_privacy_mode.h"
+#include "chrome/browser/helium_workspaces/helium_workspaces.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "components/prefs/pref_service.h"
+
+namespace heliumpp_sidebar {
+
+namespace {
+// helium_privacy_mode keeps its level pref private; same string.
+constexpr char kPrivacyModePref[] = "helium.privacy_mode";
+}  // namespace
+
+SidebarPageHandler::SidebarPageHandler(
+    mojo::PendingRemote<mojom::Page> page,
+    mojo::PendingReceiver<mojom::PageHandler> receiver,
+    BrowserWindowInterface* browser)
+    : page_(std::move(page)),
+      receiver_(this, std::move(receiver)),
+      browser_(browser) {
+  registrar_.Init(browser_->GetProfile()->GetPrefs());
+  const auto send = base::BindRepeating(&SidebarPageHandler::SendState,
+                                        base::Unretained(this));
+  registrar_.Add(helium_workspaces::kWorkspacesPref, send);
+  registrar_.Add(helium_workspaces::kActiveWorkspacePref, send);
+  registrar_.Add(kPrivacyModePref, send);
+  registrar_.Add(helium_privacy_mode::kPerformanceModePref, send);
+}
+
+SidebarPageHandler::~SidebarPageHandler() = default;
+
+mojom::StatePtr SidebarPageHandler::BuildState() const {
+  auto state = mojom::State::New();
+  for (const helium_workspaces::Info& info :
+       helium_workspaces::List(browser_->GetProfile())) {
+    state->workspaces.push_back(mojom::Workspace::New(info.id, info.name));
+  }
+  state->active_workspace = helium_workspaces::ActiveId(browser_);
+  state->privacy_level =
+      helium_privacy_mode::GetModeName(browser_->GetProfile());
+  state->performance_mode =
+      helium_privacy_mode::IsPerformanceMode(browser_->GetProfile());
+  return state;
+}
+
+void SidebarPageHandler::SendState() {
+  page_->OnStateChanged(BuildState());
+}
+
+void SidebarPageHandler::GetState(GetStateCallback callback) {
+  std::move(callback).Run(BuildState());
+}
+
+void SidebarPageHandler::SwitchWorkspace(const std::string& id) {
+  // Switch() ignores ids that do not exist.
+  helium_workspaces::Switch(browser_, id);
+}
+
+void SidebarPageHandler::CreateWorkspace() {
+  helium_workspaces::Create(browser_);
+}
+
+void SidebarPageHandler::SetPrivacyLevel(const std::string& level) {
+  // SetMode() rejects anything but the three level names.
+  helium_privacy_mode::SetMode(browser_->GetProfile(), level);
+}
+
+void SidebarPageHandler::SetPerformanceMode(bool enabled) {
+  helium_privacy_mode::SetPerformanceMode(browser_->GetProfile(), enabled);
+}
+
+void SidebarPageHandler::RunCommand(mojom::Command command) {
+  int id = 0;
+  switch (command) {
+    case mojom::Command::kNewTab:
+      id = IDC_NEW_TAB;
+      break;
+    case mojom::Command::kNewFolder:
+      id = IDC_CREATE_NEW_TAB_GROUP;
+      break;
+    case mojom::Command::kHistory:
+      id = IDC_SHOW_HISTORY;
+      break;
+    case mojom::Command::kBookmarks:
+      id = IDC_SHOW_BOOKMARK_MANAGER;
+      break;
+    case mojom::Command::kDownloads:
+      id = IDC_SHOW_DOWNLOADS;
+      break;
+    case mojom::Command::kExtensions:
+      id = IDC_MANAGE_EXTENSIONS;
+      break;
+    case mojom::Command::kSettings:
+      id = IDC_OPTIONS;
+      break;
+    case mojom::Command::kFocusLocationBar:
+      id = IDC_FOCUS_LOCATION;
+      break;
+  }
+  chrome::ExecuteCommand(browser_, id);
+}
+
+}  // namespace heliumpp_sidebar
