+/* Copyright 2026 The Helium Authors
+ * You can use, redistribute, and/or modify this source code under
+ * the terms of the GPL-3.0 license that can be found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+/* Every colour is a browser theme token, so the sidebar follows the
+   wallpaper-derived theme in light and dark. The page itself is see-through:
+   the native window (acrylic glass or theme frame) shows behind it. */
+:host {
+  --ink: var(--color-tab-foreground-active-frame-active);
+  --ink-2: var(--color-tab-foreground-inactive-frame-active);
+  --hover: var(--color-sys-state-hover-on-subtle);
+  --selected: var(--color-tab-background-active-frame-active);
+  --accent: var(--color-sys-primary);
+  --tonal: var(--color-sys-tonal-container);
+  --on-tonal: var(--color-sys-on-tonal-container);
+  --panel: var(--color-sys-base-container-elevated, var(--color-sys-surface));
+  --edge: color-mix(in srgb, var(--ink) 10%, transparent);
+  color: var(--ink);
+  display: flex;
+  flex-direction: column;
+  font-size: 13px;
+  height: 100vh;
+  padding: 4px 8px 8px 10px;
+  box-sizing: border-box;
+  position: relative;
+  user-select: none;
+}
+
+button {
+  background: none;
+  border: 0;
+  color: inherit;
+  cursor: pointer;
+  font: inherit;
+  padding: 0;
+}
+
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
+.i {
+  fill: none;
+  flex: none;
+  height: 16px;
+  stroke: currentColor;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-width: 1.7;
+  width: 16px;
+}
+
+.icon-btn {
+  border-radius: 8px;
+  color: var(--ink-2);
+  display: grid;
+  height: 28px;
+  place-items: center;
+  width: 28px;
+}
+
+.icon-btn:hover {
+  background: var(--hover);
+  color: var(--ink);
+}
+
+/* Workspaces: named segments. */
+.spaces {
+  background: var(--hover);
+  border-radius: 10px;
+  display: flex;
+  gap: 2px;
+  margin: 4px 0 10px;
+  padding: 3px;
+}
+
+.spaces button {
+  border-radius: 8px;
+  color: var(--ink-2);
+  flex: 1;
+  font-weight: 600;
+  height: 26px;
+  min-width: 0;
+  overflow: hidden;
+  padding: 0 6px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.spaces button[aria-pressed='true'] {
+  background: var(--selected);
+  box-shadow: 0 1px 2px color-mix(in srgb, var(--ink) 14%, transparent);
+  color: var(--ink);
+}
+
+.spaces .add {
+  display: grid;
+  flex: none;
+  place-items: center;
+  width: 26px;
+}
+
+/* Essentials: square tiles. */
+.essentials {
+  display: grid;
+  gap: 6px;
+  grid-template-columns: repeat(4, 1fr);
+  margin-bottom: 8px;
+}
+
+.tile {
+  aspect-ratio: 1;
+  background: var(--hover);
+  border-radius: 10px;
+  display: grid;
+  max-height: 52px;
+  place-items: center;
+}
+
+.tile:hover {
+  background: var(--selected);
+}
+
+.tile[aria-selected='true'] {
+  background: var(--selected);
+  box-shadow: 0 0 0 1.5px var(--accent) inset;
+}
+
+.tile .fav {
+  height: 20px;
+  width: 20px;
+}
+
+/* Tab list. */
+.scroll {
+  flex: 1;
+  margin-inline-end: -4px;
+  min-height: 0;
+  overflow-y: auto;
+  padding-inline-end: 4px;
+  scrollbar-width: thin;
+}
+
+.tab {
+  align-items: center;
+  border-radius: 8px;
+  color: var(--ink-2);
+  cursor: default;
+  display: flex;
+  gap: 9px;
+  height: 34px;
+  padding: 0 4px 0 9px;
+}
+
+.tab:hover {
+  background: var(--hover);
+  color: var(--ink);
+}
+
+.tab[aria-selected='true'] {
+  background: var(--selected);
+  box-shadow: 0 1px 2px color-mix(in srgb, var(--ink) 12%, transparent),
+      0 0 0 1px var(--edge) inset;
+  color: var(--ink);
+}
+
+.fav {
+  border-radius: 4px;
+  flex: none;
+  height: 16px;
+  width: 16px;
+}
+
+.t {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.tab .x {
+  height: 24px;
+  opacity: 0;
+  width: 24px;
+}
+
+.tab:hover .x,
+.tab[aria-selected='true'] .x {
+  opacity: 1;
+}
+
+/* Folders (tab groups): a quiet row, the colour as a swatch and a rail. */
+.folder .head {
+  align-items: center;
+  border-radius: 8px;
+  display: flex;
+  font-weight: 600;
+  gap: 8px;
+  height: 32px;
+  padding: 0 8px;
+  width: 100%;
+}
+
+.folder .head:hover {
+  background: var(--hover);
+}
+
+.folder .chev {
+  color: var(--ink-2);
+  display: grid;
+  transition: transform 150ms cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+.folder .head[aria-expanded='true'] .chev {
+  transform: rotate(90deg);
+}
+
+.folder .swatch {
+  background: var(--c);
+  border-radius: 3px;
+  height: 10px;
+  width: 10px;
+}
+
+.folder .t {
+  text-align: start;
+}
+
+.folder .count {
+  color: var(--ink-2);
+  font-variant-numeric: tabular-nums;
+  font-weight: 500;
+}
+
+.folder .items {
+  border-inline-start: 1.5px solid var(--c);
+  margin-inline-start: 13px;
+  padding-inline-start: 6px;
+}
+
+.newtab {
+  align-items: center;
+  border-radius: 8px;
+  color: var(--ink-2);
+  display: flex;
+  gap: 9px;
+  height: 34px;
+  margin-top: 2px;
+  padding: 0 9px;
+  width: 100%;
+}
+
+.newtab:hover {
+  background: var(--hover);
+  color: var(--ink);
+}
+
+.newtab kbd {
+  color: var(--ink-2);
+  font-family: inherit;
+  font-size: 11px;
+  font-weight: 500;
+  margin-inline-start: auto;
+}
+
+/* Footer: the shield, then quiet actions. */
+.foot {
+  align-items: center;
+  border-top: 1px solid var(--edge);
+  display: flex;
+  gap: 2px;
+  margin-top: 6px;
+  padding-top: 8px;
+}
+
+.shield {
+  align-items: center;
+  background: var(--tonal);
+  border-radius: 8px;
+  color: var(--on-tonal);
+  display: flex;
+  gap: 6px;
+  height: 30px;
+  margin-inline-end: auto;
+  padding: 0 10px 0 8px;
+}
+
+.shield b {
+  font-weight: 600;
+}
+
+/* Shield panel, above the footer. */
+.panel {
+  background: var(--panel);
+  border-radius: 14px;
+  bottom: 52px;
+  box-shadow: 0 1px 2px rgb(0 0 0 / 12%), 0 12px 32px -8px rgb(0 0 0 / 35%),
+      0 0 0 1px var(--edge);
+  left: 8px;
+  padding: 14px;
+  position: absolute;
+  right: 8px;
+  z-index: 1;
+}
+
+.panel h2 {
+  align-items: center;
+  display: flex;
+  font-size: 14px;
+  font-weight: 700;
+  gap: 8px;
+  margin: 0 0 10px;
+}
+
+.panel h2 .i {
+  color: var(--accent);
+}
+
+.seg {
+  background: var(--hover);
+  border-radius: 10px;
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  padding: 3px;
+}
+
+.seg button {
+  border-radius: 8px;
+  color: var(--ink-2);
+  font-weight: 600;
+  height: 30px;
+}
+
+.seg button[aria-pressed='true'] {
+  background: var(--selected);
+  box-shadow: 0 1px 2px rgb(0 0 0 / 14%), 0 0 0 1px var(--edge);
+  color: var(--ink);
+}
+
+.toggle-row {
+  align-items: center;
+  border-top: 1px solid var(--edge);
+  display: flex;
+  gap: 10px;
+  margin-top: 12px;
+  padding-top: 12px;
+}
+
+.toggle-row div {
+  flex: 1;
+}
+
+.toggle-row strong {
+  display: block;
+  font-weight: 600;
+}
+
+.toggle-row small {
+  color: var(--ink-2);
+  font-size: 12px;
+}
+
+.switch {
+  background: var(--hover);
+  border-radius: 10px;
+  box-shadow: 0 0 0 1px var(--edge) inset;
+  height: 20px;
+  position: relative;
+  width: 36px;
+}
+
+.switch::after {
+  background: var(--ink-2);
+  border-radius: 50%;
+  content: '';
+  height: 16px;
+  left: 2px;
+  position: absolute;
+  top: 2px;
+  transition: transform 150ms ease-out;
+  width: 16px;
+}
+
+.switch[aria-checked='true'] {
+  background: var(--accent);
+}
+
+.switch[aria-checked='true']::after {
+  background: var(--color-sys-on-primary);
+  transform: translateX(16px);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * {
+    transition: none !important;
+  }
+}
