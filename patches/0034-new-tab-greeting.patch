+
+/* Browser-specific look: calm centred greeting, glow tinted by the theme accent. */
+:host::before {
+  background:
+    radial-gradient(70% 60% at 50% 40%,
+      color-mix(in oklab, var(--color-new-tab-page-focus-ring) 22%, transparent),
+      transparent 70%),
+    linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.3));
+  content: '';
+  inset: 0;
+  pointer-events: none;
+  position: fixed;
+  z-index: 0;
+}
+
+#greeting {
+  margin-bottom: 30px;
+  text-align: center;
+}
+
+#greeting h1 {
+  font-size: clamp(34px, 5.4vw, 64px);
+  font-weight: 500;
+  letter-spacing: -0.02em;
+  color: var(--color-new-tab-page-primary-foreground);
+  margin: 0 0 10px;
+  text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
+}
+
+#greeting .sub {
+  font-size: clamp(16px, 1.8vw, 22px);
+  color: var(--color-new-tab-page-secondary-foreground);
+}
