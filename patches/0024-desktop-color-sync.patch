+// The desktop's own accent color, when the platform has one: the Omarchy theme's
+// `accent` (colors.toml) on Linux, the Windows accent color, the macOS accent
+// color. Runs on a blocking thread. Not verified on Windows or macOS yet.
+std::optional<SkColor> DesktopAccentColor() {
+#if BUILDFLAG(IS_LINUX)
+  std::string toml;
+  if (!base::ReadFileToString(OmarchyCurrentDir().Append("theme/colors.toml"),
+                              &toml)) {
+    return std::nullopt;
+  }
+  for (std::string_view line : base::SplitStringPiece(
+           toml, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (!line.starts_with("accent")) {
+      continue;
+    }
+    const size_t open = line.find('"');
+    const size_t close = open == std::string_view::npos
+                             ? std::string_view::npos
+                             : line.find('"', open + 1);
+    if (close == std::string_view::npos || close - open != 8 ||
+        line[open + 1] != '#') {
+      return std::nullopt;
+    }
+    uint32_t rgb = 0;
+    if (!base::HexStringToUInt(line.substr(open + 2, 6), &rgb)) {
+      return std::nullopt;
+    }
+    return SkColorSetRGB((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF);
+  }
+  return std::nullopt;
+#elif BUILDFLAG(IS_WIN)
+  base::win::RegKey key(HKEY_CURRENT_USER,
+                        L"Software\\Microsoft\\Windows\\DWM", KEY_READ);
+  DWORD abgr = 0;
+  if (!key.Valid() || key.ReadValueDW(L"AccentColor", &abgr) != ERROR_SUCCESS) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB(abgr & 0xFF, (abgr >> 8) & 0xFF, (abgr >> 16) & 0xFF);
+#elif BUILDFLAG(IS_MAC)
+  return helium_theme::MacSystemAccentColor();
+#else
+  return std::nullopt;
+#endif
+}
