+// Where the desktop's colors come from this time.
+struct Source {
+  std::optional<SkColor> accent;
+  base::FilePath wallpaper;
+};
+
+Source ReadSource(base::FilePath wallpaper_override) {
+  Source source;
+  if (wallpaper_override.empty()) {
+    source.accent = DesktopAccentColor();
+    source.wallpaper = DefaultWallpaperPath();
+  } else {
+    source.wallpaper = wallpaper_override;
+  }
+  return source;
+}
+
+// The desktop's own accent wins; otherwise the wallpaper's dominant color.
+void OnSource(base::WeakPtr<Profile> profile, Source source) {
+  if (!profile) {
+    return;
+  }
+  if (source.accent) {
+    ApplyColor(profile.get(), *source.accent);
+    return;
+  }
+  if (source.wallpaper.empty()) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadWallpaper, source.wallpaper),
+      base::BindOnce(&OnRead, profile));
+}
+
+// Re-applies when the desktop changes: the system theme or accent (all
+// platforms, via NativeTheme) and Omarchy's theme switch (the symlinks in its
+// "current" directory change). shortcut: tracks the last profile that applied,
+// which is fine while a single profile is open.
+class DesktopWatcher : public ui::NativeThemeObserver {
+ public:
+  void Start(base::WeakPtr<Profile> profile, base::FilePath wallpaper_override) {
+    profile_ = profile;
+    wallpaper_override_ = std::move(wallpaper_override);
+    if (started_) {
+      return;
+    }
+    started_ = true;
+    observation_.Observe(ui::NativeTheme::GetInstanceForNativeUi());
+#if BUILDFLAG(IS_LINUX)
+    if (wallpaper_override_.empty()) {
+      std::ignore = watcher_.Watch(
+          OmarchyCurrentDir(), base::FilePathWatcher::Type::kNonRecursive,
+          base::BindRepeating(&DesktopWatcher::OnFileChanged,
+                              base::Unretained(this)));
+    }
+#endif
+  }
+
+  void Reload() {
+    if (!profile_) {
+      return;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadSource, wallpaper_override_),
+        base::BindOnce(&OnSource, profile_));
+  }
+
+ private:
+  void OnNativeThemeUpdated(ui::NativeTheme*) override { Schedule(); }
+  void OnFileChanged(const base::FilePath&, bool) { Schedule(); }
+  void Schedule() {
+    timer_.Start(FROM_HERE, base::Milliseconds(600),
+                 base::BindOnce(&DesktopWatcher::Reload, base::Unretained(this)));
+  }
+
+  base::WeakPtr<Profile> profile_;
+  base::FilePath wallpaper_override_;
+  bool started_ = false;
+  base::OneShotTimer timer_;
+  base::FilePathWatcher watcher_;
+  base::ScopedObservation<ui::NativeTheme, ui::NativeThemeObserver>
+      observation_{this};
+};
+
+DesktopWatcher& Watcher() {
+  static base::NoDestructor<DesktopWatcher> watcher;
+  return *watcher;
+}
