+#include "chrome/browser/helium_theme/helium_theme_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include "base/strings/sys_string_conversions.h"
+
+namespace helium_theme {
+
+std::optional<SkColor> MacSystemAccentColor() {
+  NSColor* color = [[NSColor controlAccentColor]
+      colorUsingColorSpace:[NSColorSpace sRGBColorSpace]];
+  if (!color) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB(static_cast<int>(color.redComponent * 255 + 0.5),
+                       static_cast<int>(color.greenComponent * 255 + 0.5),
+                       static_cast<int>(color.blueComponent * 255 + 0.5));
+}
+
+base::FilePath MacDesktopWallpaperPath() {
+  NSURL* url = [[NSWorkspace sharedWorkspace]
+      desktopImageURLForScreen:[NSScreen mainScreen]];
+  if (!url || !url.isFileURL) {
+    return base::FilePath();
+  }
+  return base::FilePath(base::SysNSStringToUTF8(url.path));
+}
+
+}  // namespace helium_theme
