+// A simple shape button: a small dot, or a longer pill when selected. Colours
+// are theme tokens, so they follow the wallpaper theme.
+class WorkspaceDot : public views::Button {
+  METADATA_HEADER(WorkspaceDot, views::Button)
+
+ public:
+  WorkspaceDot(PressedCallback callback, bool selected, std::u16string name)
+      : views::Button(std::move(callback)), selected_(selected) {
+    SetTooltipText(std::move(name));
+    SetPreferredSize(gfx::Size(
+        (selected ? kSelectedDotWidth : kDotSize) + kDotSlotPadding,
+        kDotSlotHeight));
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    SkColor color = GetColorProvider()->GetColor(
+        selected_ ? ui::kColorSysPrimary : ui::kColorSysOnSurfaceSubtle);
+    flags.setColor(selected_ ? color : SkColorSetA(color, 0x99));
+    const int width = selected_ ? kSelectedDotWidth : kDotSize;
+    gfx::Rect rect(0, 0, width, kDotSize);
+    rect.set_origin(gfx::Point((this->width() - width) / 2,
+                               (height() - kDotSize) / 2));
+    canvas->DrawRoundRect(rect, kDotSize / 2, flags);
+  }
+
+ private:
+  const bool selected_;
+};
