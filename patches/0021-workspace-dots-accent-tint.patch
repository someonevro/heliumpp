+
+bool WorkspaceSwitcher::AcceleratorPressed(const ui::Accelerator& accelerator) {
+  SwitchRelative(accelerator.key_code() == ui::VKEY_RIGHT ? 1 : -1);
+  return true;
+}
+
+void WorkspaceSwitcher::SwitchRelative(int delta) {
+  Profile* profile = browser_->GetProfile();
+  const std::vector<helium_workspaces::Info> all =
+      helium_workspaces::List(profile);
+  const std::string active = helium_workspaces::ActiveId(profile);
+  const int count = static_cast<int>(all.size());
+  for (int i = 0; i < count; ++i) {
+    if (all[i].id == active) {
+      helium_workspaces::Switch(browser_, all[(i + delta + count) % count].id);
+      return;
+    }
+  }
+}
