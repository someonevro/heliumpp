+namespace {
+
+// Helium++ UI font (Satoshi) for WebUI pages: served from <exe dir>/fonts as
+// chrome://resources/fonts/<file>. Web pages cannot load chrome:// URLs, so the
+// font stays out of reach of websites (license, fingerprinting).
+constexpr const char* kUiFontFiles[] = {"fonts/Satoshi-Variable.ttf",
+                                        "fonts/Satoshi-VariableItalic.ttf"};
+
+bool IsUiFontPath(const std::string& path) {
+  return std::ranges::find(kUiFontFiles, path) != std::end(kUiFontFiles);
+}
+
+scoped_refptr<base::RefCountedMemory> ReadUiFont(const std::string& path) {
+  base::FilePath exe;
+  std::string data;
+  if (base::PathService::Get(base::DIR_EXE, &exe)) {
+    base::ReadFileToString(exe.AppendASCII(path), &data);
+  }
+  return base::MakeRefCounted<base::RefCountedString>(std::move(data));
+}
+
+}  // namespace
+
 void PopulateSharedResourcesDataSource(WebUIDataSource* source) {
+  source->SetRequestFilter(
+      base::BindRepeating(&IsUiFontPath),
+      base::BindRepeating([](const std::string& path,
+                             WebUIDataSource::GotDataCallback callback) {
+        base::ThreadPool::PostTaskAndReplyWithResult(
+            FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+            base::BindOnce(&ReadUiFont, path), std::move(callback));
+      }));
+
   source->OverrideContentSecurityPolicy(
       network::mojom::CSPDirectiveName::WorkerSrc, "worker-src blob: 'self';");
 
