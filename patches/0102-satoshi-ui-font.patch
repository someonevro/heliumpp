+base::FilePath UiFontFile(bool italic) {
+  base::FilePath exe;
+  if (!base::PathService::Get(base::DIR_EXE, &exe)) {
+    return base::FilePath();
+  }
+  return exe.Append("fonts").Append(italic ? "Satoshi-VariableItalic.ttf"
+                                           : "Satoshi-Variable.ttf");
+}
+
+// One instance of the variable font per (weight, italic), created on first use.
+sk_sp<SkTypeface> UiTypeface(SkFontMgr* fm, SkFontStyle style) {
+  const bool italic = style.slant() != SkFontStyle::kUpright_Slant;
+  // Satoshi's 400 is light at UI sizes (12-14 px); nudge regular text up a little.
+  int weight = style.weight() == SkFontStyle::kNormal_Weight ? 450 : style.weight();
+  weight = std::clamp(weight, 300, 900);
+  static base::NoDestructor<base::Lock> lock;
+  static base::NoDestructor<std::map<std::pair<int, bool>, sk_sp<SkTypeface>>>
+      cache;
+  base::AutoLock hold(*lock);
+  sk_sp<SkTypeface>& face = (*cache)[{weight, italic}];
+  if (!face) {
+    std::unique_ptr<SkStreamAsset> stream =
+        SkStream::MakeFromFile(UiFontFile(italic).value().c_str());
+    if (!stream) {
+      return nullptr;
+    }
+    const SkFontArguments::VariationPosition::Coordinate wght = {
+        SkSetFourByteTag('w', 'g', 'h', 't'), static_cast<float>(weight)};
+    SkFontArguments args;
+    args.setVariationDesignPosition({&wght, 1});
+    face = fm->makeFromStream(std::move(stream), args);
+  }
+  return face;
+}
+
+}  // namespace
+
+bool HasUiFont() {
+#if BUILDFLAG(IS_LINUX)
+  static const bool present = base::PathExists(UiFontFile(false)) &&
+                              base::PathExists(UiFontFile(true));
+  return present;
+#else
+  return false;
+#endif
+}
+
 sk_sp<SkTypeface> MakeTypefaceFromName(const char* name, SkFontStyle style) {
   sk_sp<SkFontMgr> fm = DefaultFontMgr();
   CHECK(fm);
+  if (name && base::EqualsCaseInsensitiveASCII(name, kUiFontFamily) &&
+      HasUiFont()) {
+    if (sk_sp<SkTypeface> face = UiTypeface(fm.get(), style)) {
+      return face;
+    }
+  }
   sk_sp<SkTypeface> face = fm->legacyMakeTypeface(name, style);
   return face;
 }
