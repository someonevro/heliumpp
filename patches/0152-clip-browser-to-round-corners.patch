+void BrowserFrameViewLinux::Layout(PassKey) {
+  LayoutSuperclass<OpaqueBrowserFrameView>(this);
+  // The frame paints rounded corners, but the browser's own views (sidebar,
+  // page card, top container) paint square ones over it. Clip them all to the
+  // window's shape with one rounded layer on the browser view.
+  BrowserView* const browser_view = GetBrowserView();
+  if (!browser_view) {
+    return;
+  }
+  const gfx::RoundedCornersF corners = GetWindowRoundedCorners();
+  if (!browser_view->layer()) {
+    if (corners.IsEmpty()) {
+      return;
+    }
+    browser_view->SetPaintToLayer();
+    browser_view->layer()->SetFillsBoundsOpaquely(false);
+  }
+  browser_view->layer()->SetRoundedCornerRadius(corners);
+  browser_view->layer()->SetIsFastRoundedCorner(true);
+}
