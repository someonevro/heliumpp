+void SidebarPageHandler::GetIsolatedTabs(GetIsolatedTabsCallback callback) {
+  std::vector<std::string> ids;
+  for (tabs::TabInterface* tab : browser_->GetAllTabInterfaces()) {
+    if (helium_privacy_mode::IsIsolatedWebContents(tab->GetContents())) {
+      ids.push_back(base::NumberToString(tab->GetHandle().raw_value()));
+    }
+  }
+  std::move(callback).Run(std::move(ids));
+}
