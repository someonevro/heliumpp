+  // Isolation is fixed when a tab is made, so asking after list changes is
+  // enough; a new Set only when it changed, to skip needless renders.
+  private refreshIsolated_() {
+    this.proxy_.handler.getIsolatedTabs().then(({tabIds}) => {
+      if (tabIds.length !== this.isolated_.size ||
+          tabIds.some(id => !this.isolated_.has(id))) {
+        this.isolated_ = new Set(tabIds);
+      }
+    });
+  }
+
+  protected isIsolated_(tab: Tab): boolean {
+    return this.isolated_.has(tab.id.split(':')[0]!);
+  }
+
+  protected tabTitle_(tab: Tab): string {
+    return this.isIsolated_(tab) ?
+        `${tab.title} (isolated tab: its own cookies and storage, nothing saved)` :
+        tab.title;
+  }
+
   protected levelHint_(): string {
