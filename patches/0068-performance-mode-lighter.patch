 // Forces (or stops forcing) reduced motion for the whole browser UI. Every
 // RichAnimationDuration() caller then runs with zero duration.
+// Open pages get it too: their WebPreferences read PrefersReducedMotion(), so
+// recompute them (CSS `prefers-reduced-motion: reduce` then matches).
 void ApplyReducedMotion(bool enabled) {
   if (enabled) {
     gfx::Animation::SetPrefersReducedMotionForTesting(true);
   } else {
     gfx::Animation::UpdatePrefersReducedMotion();
   }
+  std::set<content::WebContents*> pages;
+  for (auto it = content::RenderProcessHost::AllHostsIterator(); !it.IsAtEnd();
+       it.Advance()) {
+    it.GetCurrentValue()->ForEachRenderFrameHost(
+        [&pages](content::RenderFrameHost* frame) {
+          if (auto* contents = content::WebContents::FromRenderFrameHost(frame)) {
+            pages.insert(contents);
+          }
+        });
+  }
+  for (content::WebContents* contents : pages) {
+    contents->NotifyPreferencesChanged();
+  }
 }
 
