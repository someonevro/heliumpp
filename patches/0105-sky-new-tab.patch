+
+  // Time of day for the sky: phase name plus where the sun (day) or moon
+  // (night) sits on its arc, as percentages of the page.
+  protected sky_(): {phase: string, x: number, y: number} {
+    const h = this.now_.getHours() + this.now_.getMinutes() / 60;
+    const phase = h < 5 || h >= 21 ? 'night' : h < 8 ? 'dawn' :
+        h < 17 ? 'day' : 'dusk';
+    const p = h >= 6 && h < 18 ? (h - 6) / 12 : ((h + 6) % 24) / 12;
+    // Low arc near the top edge, so the orb never sits behind the text.
+    return {phase, x: 8 + 84 * p, y: 24 - 18 * Math.sin(Math.PI * p)};
+  }
