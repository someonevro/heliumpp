+  // "14:32 · Saturday 25 October" in the user's locale.
+  protected clock_(): string {
+    const time = this.now_.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});
+    const date = this.now_.toLocaleDateString(
+        [], {weekday: 'long', day: 'numeric', month: 'long'});
