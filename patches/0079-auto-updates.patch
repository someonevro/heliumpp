+
+// Installs verified updates in the background; they apply on the next launch.
+// Does nothing (no network request) unless running from an AppImage.
+void StartHeliumAutoUpdate() {
+  static base::NoDestructor<HeliumAppImageUpdater> updater;
+  static base::NoDestructor<base::RepeatingTimer> timer;
+  auto check = base::BindRepeating([] {
+    updater->CheckForUpdate(base::DoNothing(), VersionUpdater::PromoteCallback());
+  });
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, check, kFirstAutoCheck);
+  timer->Start(FROM_HERE, kAutoCheckInterval, check);
+}
