+  // Drag and drop (tab rows, essentials tiles, folder heads, the list's empty
+  // end). A drop becomes one MoveNode call, so pinning, unpinning and folder
+  // changes follow the tab strip's own rules.
+  private dragId_ = '';
+  private dropEl_: HTMLElement|null = null;
+
+  protected onDragstart_(e: DragEvent) {
+    this.dragId_ = this.idOf_(e);
+    e.dataTransfer!.effectAllowed = 'move';
+    e.dataTransfer!.setData('text/plain', '');
+  }
+
+  protected onDragend_() {
+    this.dragId_ = '';
+    this.markDrop_(null, '');
+  }
+
+  private markDrop_(el: HTMLElement|null, where: string) {
+    if (this.dropEl_ && this.dropEl_ !== el) {
+      delete this.dropEl_.dataset['drop'];
+    }
+    this.dropEl_ = el;
+    if (el) {
+      el.dataset['drop'] = where;
+    }
+  }
+
+  // Before / after a row or tile, or into a folder (lower part of its head).
+  private dropWhere_(e: DragEvent, el: HTMLElement): string {
+    const r = el.getBoundingClientRect();
+    if (el.classList.contains('scroll')) {
+      return 'end';
+    }
+    if (el.classList.contains('tile')) {
+      return e.clientX < r.left + r.width / 2 ? 'before' : 'after';
+    }
+    if (el.classList.contains('head')) {
+      return e.clientY < r.top + r.height / 3 ? 'before' : 'into';
+    }
+    return e.clientY < r.top + r.height / 2 ? 'before' : 'after';
+  }
+
+  protected onDragover_(e: DragEvent) {
+    if (!this.dragId_) {
+      return;
+    }
+    e.preventDefault();
+    e.stopPropagation();
+    const el = e.currentTarget as HTMLElement;
+    const where = this.dropWhere_(e, el);
+    this.markDrop_(where === 'end' ? null : el, where);
+  }
+
+  protected onDrop_(e: DragEvent) {
+    const dragged = this.dragId_;
+    if (!dragged) {
+      return;
+    }
+    e.preventDefault();
+    e.stopPropagation();
+    const el = e.currentTarget as HTMLElement;
+    const position =
+        this.dropPosition_(dragged, el.dataset['id'] || '', this.dropWhere_(e, el));
+    this.onDragend_();
+    if (position) {
+      this.proxy_.tabs.moveNode(dragged, position);
+    }
+  }
