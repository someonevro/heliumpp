+namespace {
+// Helium++: copies made from incognito or isolated tabs (partition domain
+// "heliumisolated") stay out of clipboard history, like the page's own copies.
+void MaybeMarkOffTheRecord(content::WebContents* contents,
+                           ui::ScopedClipboardWriter& scw) {
+  if (!contents || contents->GetBrowserContext()->IsOffTheRecord() ||
+      contents->GetPrimaryMainFrame()
+              ->GetStoragePartition()
+              ->GetConfig()
+              .partition_domain() == "heliumisolated") {
+    scw.MarkAsOffTheRecord();
+  }
+}
+}  // namespace
