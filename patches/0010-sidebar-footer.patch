+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_VERTICAL_TAB_STRIP_FOOTER_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_VERTICAL_TAB_STRIP_FOOTER_H_
+
+#include <string_view>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/layout/flex_layout_view.h"
+
+class BrowserWindowInterface;
+
+namespace gfx {
+struct VectorIcon;
+}
+
+namespace tabs {
+class VerticalTabStripStateController;
+enum class VerticalTabStripCollapseState;
+}  // namespace tabs
+
+// A row of icon buttons at the bottom of the vertical tab strip that opens
+// settings, extensions, downloads, history and the bookmark manager. Laid out
+// horizontally when the strip is expanded and vertically when it is collapsed.
+class VerticalTabStripFooter : public views::FlexLayoutView {
+  METADATA_HEADER(VerticalTabStripFooter, views::FlexLayoutView)
+
+ public:
+  VerticalTabStripFooter(tabs::VerticalTabStripStateController* state_controller,
+                         BrowserWindowInterface* browser);
+  ~VerticalTabStripFooter() override;
+
+ private:
+  void AddButton(const gfx::VectorIcon& icon,
+                 int command_id,
+                 std::u16string_view tooltip);
+  void OnCollapseStateChanged(tabs::VerticalTabStripCollapseState state);
+
+  raw_ptr<BrowserWindowInterface> browser_ = nullptr;
+  base::CallbackListSubscription collapsed_state_change_subscription_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_VERTICAL_TAB_STRIP_FOOTER_H_
