@@ -0,0 +1,67 @@
+#include "chrome/browser/ui/views/tabs/vertical/vertical_tab_strip_footer.h"
+
+#include <string>
+
+#include "base/functional/bind.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "components/vector_icons/vector_icons.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/views/controls/button/image_button.h"
+#include "ui/views/controls/button/image_button_factory.h"
+#include "ui/views/layout/flex_layout_types.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+constexpr int kIconSize = 18;
+}  // namespace
+
+VerticalTabStripFooter::VerticalTabStripFooter(
+    tabs::VerticalTabStripStateController* state_controller,
+    BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetMainAxisAlignment(views::LayoutAlignment::kCenter);
+  SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+
+  AddButton(vector_icons::kSettingsIcon, IDC_OPTIONS, u"Settings");
+  AddButton(vector_icons::kChromeExtensionIcon, IDC_MANAGE_EXTENSIONS,
+            u"Extensions");
+  AddButton(vector_icons::kDownloadIcon, IDC_SHOW_DOWNLOADS, u"Downloads");
+  AddButton(vector_icons::kHistoryIcon, IDC_SHOW_HISTORY, u"History");
+  AddButton(kBookmarkManagerIcon, IDC_SHOW_BOOKMARK_MANAGER, u"Bookmarks");
+
+  OnCollapseStateChanged(state_controller->GetCollapseState());
+  collapsed_state_change_subscription_ =
+      state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+          &VerticalTabStripFooter::OnCollapseStateChanged,
+          base::Unretained(this)));
+}
+
+VerticalTabStripFooter::~VerticalTabStripFooter() = default;
+
+void VerticalTabStripFooter::AddButton(const gfx::VectorIcon& icon,
+                                       int command_id,
+                                       std::u16string_view tooltip) {
+  auto button = views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(
+          [](BrowserWindowInterface* browser, int command_id) {
+            chrome::ExecuteCommand(browser, command_id);
+          },
+          browser_, command_id),
+      icon, kIconSize);
+  button->SetTooltipText(std::u16string(tooltip));
+  button->SetProperty(views::kMarginsKey, gfx::Insets::VH(2, 2));
+  AddChildView(std::move(button));
+}
+
+void VerticalTabStripFooter::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  SetOrientation(state == tabs::VerticalTabStripCollapseState::kExpanded
+                     ? views::LayoutOrientation::kHorizontal
+                     : views::LayoutOrientation::kVertical);
+}
+
+BEGIN_METADATA(VerticalTabStripFooter)
+END_METADATA
