+// static
+void TabView::PaintIsolatedBadge(const views::PaintInfo& info,
+                                 const views::View& view,
+                                 const gfx::Rect& icon_bounds) {
+  ui::PaintRecorder recorder(info.context(), view.size());
+  gfx::Canvas* canvas = recorder.canvas();
+  const gfx::PointF center(icon_bounds.right() - 2.0f,
+                           icon_bounds.bottom() - 2.0f);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(view.GetColorProvider()->GetColor(ui::kColorSysSurface));
+  canvas->DrawCircle(center, 5.5f, flags);
+  flags.setColor(view.GetColorProvider()->GetColor(ui::kColorSysPrimary));
+  canvas->DrawCircle(center, 3.75f, flags);
+}
