+// choice: "cloudflare" | "google" | "system" | "custom". For "custom", |custom|
+// is an https:// DNS address or a bare IP. Rejects when the address is invalid.
+export type DnsState = { choice: string, custom: string };
+
+export const getDns = async (): Promise<DnsState> => {
+    return await cr.sendWithPromise<DnsState>('getDns');
+}
+
+export const setDns = async (choice: string, custom: string): Promise<void> => {
+    await cr.sendWithPromise('setDns', choice, custom);
+}
+
+// Mirrors the browser-side check so "Next" can stay disabled for a bad address.
+export const isValidCustomDns = (input: string): boolean => {
+    const text = input.trim();
+    if (!text || text.length > 512 || /\s/.test(text)) return false;
+    if (/^\d{1,3}(\.\d{1,3}){3}$/.test(text)) return true;
+    if (/^[0-9a-f:]+$/i.test(text) && text.includes(":")) return true;
+    try {
+        const url = new URL(text);
+        return url.protocol === "https:" && !!url.hostname && !url.username && !url.password;
+    } catch {
+        return false;
+    }
+}
