+namespace {
+
+constexpr char kCloudflareDnsTemplate[] = "https://1.1.1.1/dns-query";
+constexpr char kGoogleDnsTemplate[] = "https://8.8.8.8/dns-query";
+
+// Turns what the user typed into an encrypted-DNS (DoH) URL template, or ""
+// when it is not usable. A bare IP address becomes https://<ip>/dns-query.
+std::string NormalizeCustomDns(const std::string& input) {
+  std::string text(base::TrimWhitespaceASCII(input, base::TRIM_ALL));
+  if (text.empty() || text.size() > 512 ||
+      text.find_first_of(" \t\r\n") != std::string::npos) {
+    return std::string();
+  }
+  net::IPAddress ip;
+  if (ip.AssignFromIPLiteral(text)) {
+    return "https://" + (ip.IsIPv6() ? "[" + text + "]" : text) + "/dns-query";
+  }
+  GURL url(text);
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme) ||
+      url.host().empty() || url.has_username() || url.has_password()) {
+    return std::string();
+  }
+  return text;
+}
+
+}  // namespace
+
+// Encrypted DNS is configured with the same local-state prefs as Settings >
+// Security > "Use secure DNS", so both places always agree.
+void OnboardingMessageHandler::HandleGetDns(const base::ListValue& args) {
+  if (args.size() != 1 || !args[0].is_string()) {
+    return;
+  }
+  AllowJavascript();
+
+  PrefService* local_state = g_browser_process->local_state();
+  const std::string mode = local_state->GetString(prefs::kDnsOverHttpsMode);
+  const std::string templates =
+      local_state->GetString(prefs::kDnsOverHttpsTemplates);
+
+  std::string choice = "system";
+  std::string custom;
+  if (mode == "secure") {
+    if (templates == kCloudflareDnsTemplate) {
+      choice = "cloudflare";
+    } else if (templates == kGoogleDnsTemplate) {
+      choice = "google";
+    } else {
+      choice = "custom";
+      custom = templates;
+    }
+  }
+  base::DictValue result;
+  result.Set("choice", choice);
+  result.Set("custom", custom);
+  ResolveJavascriptCallback(args[0].GetString(), result);
+}
+
+void OnboardingMessageHandler::HandleSetDns(const base::ListValue& args) {
+  if (args.size() != 3 || !args[0].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  const auto& callback_id = args[0].GetString();
+  if (!args[1].is_string() || !args[2].is_string()) {
+    return RejectJavascriptCallback(callback_id, "bad arguments");
+  }
+
+  const std::string& choice = args[1].GetString();
+  std::string mode = "secure";
+  std::string templates;
+  if (choice == "cloudflare") {
+    templates = kCloudflareDnsTemplate;
+  } else if (choice == "google") {
+    templates = kGoogleDnsTemplate;
+  } else if (choice == "system") {
+    mode = "off";
+  } else if (choice == "custom") {
+    templates = NormalizeCustomDns(args[2].GetString());
+    if (templates.empty()) {
+      return RejectJavascriptCallback(callback_id, "invalid DNS address");
+    }
+  } else {
+    return RejectJavascriptCallback(callback_id, "unknown DNS choice");
+  }
+
+  PrefService* local_state = g_browser_process->local_state();
+  local_state->SetString(prefs::kDnsOverHttpsTemplates, templates);
+  local_state->SetString(prefs::kDnsOverHttpsMode, mode);
+  ResolveJavascriptCallback(callback_id, base::Value(templates));
+}
