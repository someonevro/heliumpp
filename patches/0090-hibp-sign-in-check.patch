+
+// Helium++: Helium keeps password saving off, and with it Chromium's sign-in leak
+// check never runs. This checks each password submitted on a page against Have
+// I Been Pwned (only 5 hex digits of its SHA-1 are sent) and shows Chromium's
+// leaked-password warning. Each password is checked once per tab.
+class HibpSignInCheck : public BulkLeakCheckDelegateInterface {
+ public:
+  explicit HibpSignInCheck(PasswordManagerClient* client) : client_(client) {}
+
+  void Check(const GURL& url,
+             const std::u16string& username,
+             const std::u16string& password) {
+    if (password.empty() ||
+        !checked_.insert(base::SHA1HashString(base::UTF16ToUTF8(password)))
+             .second) {
+      return;
+    }
+    if (!check_) {
+      check_ = LeakDetectionCheckFactoryImpl().TryCreateBulkLeakCheck(
+          this, client_->GetIdentityManager(), client_->GetURLLoaderFactory());
+      if (!check_) {
+        return;
+      }
+    }
+    urls_.push_back(url);
+    std::vector<LeakCheckCredential> credentials;
+    credentials.emplace_back(username, password);
+    check_->CheckCredentials(LeakDetectionInitiator::kSignInCheck,
+                             std::move(credentials));
+  }
+
+  void OnFinishedCredential(LeakCheckCredential credential,
+                            IsLeaked is_leaked) override {
+    PasswordForm form;
+    form.url = urls_.empty() ? GURL() : urls_.front();
+    form.signon_realm = form.url.DeprecatedGetOriginAsURL().spec();
+    form.username_value = credential.username();
+    if (!urls_.empty()) {
+      urls_.pop_front();
+    }
+    if (is_leaked) {
+      client_->NotifyUserCredentialsWereLeaked(LeakedPasswordDetails(
+          CreateLeakType(IsSaved(false), IsReused(false), IsSyncing(false)),
+          std::move(form), /*in_account_store=*/false));
+    }
+  }
+
+  // E.g. offline: drop the queue; the next submission starts a fresh checker.
+  void OnError(LeakDetectionError error) override {
+    urls_.clear();
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(check_));
+  }
+
+ private:
+  const raw_ptr<PasswordManagerClient> client_;
+  std::unique_ptr<BulkLeakCheck> check_;
+  base::circular_deque<GURL> urls_;
+  base::flat_set<std::string> checked_;
+};
