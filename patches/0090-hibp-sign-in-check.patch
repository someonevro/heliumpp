+// Helium++: password checkup without a Google account, against Have I Been
+// Pwned's Pwned Passwords range API. Only the first 5 hex digits of each
+// password's SHA-1 leave the browser ("k-anonymity"); the match against the
+// returned suffixes happens here. Padding is requested so response sizes don't
+// hint at the prefix. Runs only when the user starts the check.
+class HibpBulkLeakCheck : public BulkLeakCheck {
+ public:
+  HibpBulkLeakCheck(
+      BulkLeakCheckDelegateInterface* delegate,
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+      : delegate_(delegate), url_loader_factory_(std::move(url_loader_factory)) {}
+
+  void CheckCredentials(LeakDetectionInitiator initiator,
+                        std::vector<LeakCheckCredential> credentials) override {
+    // Only the user's own actions (a checkup, a sign-in); automatic (proactive)
+    // checkups would contact the service unasked.
+    if (initiator != LeakDetectionInitiator::kBulkSyncedPasswordsCheck &&
+        initiator != LeakDetectionInitiator::kSignInCheck) {
+      delegate_->OnError(LeakDetectionError::kNotSignIn);
+      return;
+    }
+    for (LeakCheckCredential& credential : credentials) {
+      queue_.push_back(std::move(credential));
+    }
+    if (!loader_) {
+      Next();
+    }
+  }
+
+  size_t GetPendingChecksCount() const override { return queue_.size(); }
+
+ private:
+  static std::string HashOf(const LeakCheckCredential& credential) {
+    return base::HexEncode(base::as_byte_span(
+        base::SHA1HashString(base::UTF16ToUTF8(credential.password()))));
+  }
+
+  void Next() {
+    if (queue_.empty()) {
+      return;
+    }
+    const std::string prefix = HashOf(queue_.front()).substr(0, 5);
+    if (ranges_.contains(prefix)) {
+      // Posted: the delegate may call back into this object.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&HibpBulkLeakCheck::Finish,
+                                    weak_factory_.GetWeakPtr()));
+      return;
+    }
+    static constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+        net::DefineNetworkTrafficAnnotation("helium_hibp_password_check", R"(
+          semantics {
+            sender: "Helium++ password checkup"
+            description:
+              "Checks saved passwords against Have I Been Pwned's list of "
+              "passwords from data breaches. Sends the first 5 hex digits of "
+              "a password's SHA-1 hash, never the password or the full hash."
+            trigger:
+              "The user starts a password check in the password manager, or "
+              "submits a password on a site while password saving is off."
+            data: "5 hex digits of a SHA-1 hash."
+            destination: OTHER
+            destination_other: "api.pwnedpasswords.com"
+          }
+          policy {
+            cookies_allowed: NO
+            setting: "Only runs on a password check or a password submission."
+            policy_exception_justification: "Not implemented."
+          })");
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL("https://api.pwnedpasswords.com/range/" + prefix);
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->headers.SetHeader("Add-Padding", "true");
+    loader_ = network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+    loader_->DownloadToString(
+        url_loader_factory_.get(),
+        base::BindOnce(&HibpBulkLeakCheck::OnRange, weak_factory_.GetWeakPtr(),
+                       prefix),
+        /*max_body_size=*/1024 * 1024);
+  }
+
+  void OnRange(const std::string& prefix, std::optional<std::string> body) {
+    loader_.reset();
+    if (!body) {
+      queue_.clear();
+      delegate_->OnError(LeakDetectionError::kNetworkError);
+      return;
+    }
+    ranges_[prefix] = std::move(*body);
+    Finish();
+  }
+
+  void Finish() {
+    if (queue_.empty()) {
+      return;
+    }
+    LeakCheckCredential credential = std::move(queue_.front());
+    queue_.pop_front();
+    const std::string hash = HashOf(credential);
+    bool leaked = false;
+    // Lines are "SUFFIX:COUNT"; padding lines have a count of 0.
+    for (std::string_view line :
+         base::SplitStringPiece(ranges_[hash.substr(0, 5)], "\n",
+                                base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      const size_t colon = line.find(':');
+      int count = 0;
+      if (colon != std::string_view::npos &&
+          base::EqualsCaseInsensitiveASCII(line.substr(0, colon),
+                                           std::string_view(hash).substr(5)) &&
+          base::StringToInt(line.substr(colon + 1), &count) && count > 0) {
+        leaked = true;
+        break;
+      }
+    }
+    // The delegate may delete this once nothing is pending.
+    base::WeakPtr<HibpBulkLeakCheck> self = weak_factory_.GetWeakPtr();
+    delegate_->OnFinishedCredential(std::move(credential), IsLeaked(leaked));
+    if (self) {
+      Next();
+    }
+  }
+
+  const raw_ptr<BulkLeakCheckDelegateInterface> delegate_;
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  base::circular_deque<LeakCheckCredential> queue_;
+  base::flat_map<std::string, std::string> ranges_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::WeakPtrFactory<HibpBulkLeakCheck> weak_factory_{this};
+};
+#endif  // !BUILDFLAG(IS_ANDROID)
