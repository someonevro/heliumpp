+void ComponentLoader::AddBonjourr() {
+  Add(IDR_BONJOURR_MANIFEST_JSON, base::FilePath(FILE_PATH_LITERAL("bonjourr")));
+  ComponentExtensionInfo& info = component_extensions_.back();
+  std::string error;
+  if (!extension_l10n_util::LocalizeExtension(
+          info.root_directory, &info.manifest,
+          extension_l10n_util::GzippedMessagesPermission::kAllowForTrustedSource,
+          &error, true)) {
+    LOG(ERROR) << "Failed to localize Bonjourr: " << error;
+  }
+}
+
+// Switching the new tab page takes effect at once: load or unload Bonjourr.
+// Its chrome.storage data stays, so switching back keeps the user's settings.
+void ComponentLoader::OnBonjourrPrefChanged() {
+  const bool wanted = profile_->GetPrefs()->GetBoolean(
+      helium_privacy_mode::kBonjourrNewTabPref);
+  if (wanted && !Exists(helium::kBonjourrComponentId)) {
+    AddBonjourr();
+  } else if (!wanted) {
+    Remove(helium::kBonjourrComponentId);
+  }
+}
