@@ -0,0 +1,20 @@
+# Lists the Bonjourr files for generate_grd (same interface as third_party/ublock's script, minus
+# its gzip-compressed filter-list assets: Bonjourr has none, so the .grdp stays empty).
+import json
+import os
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from sys import argv
+
+EXCLUDED = {'BUILD.gn', 'generate_file_list.py', 'README.chromium'}
+
+src = Path(argv[1])
+files = sorted(
+    (Path(root) / name).relative_to(src).as_posix()
+    for root, _, names in os.walk(src) for name in names
+    if name not in EXCLUDED or Path(root) != src)
+
+with open(argv[2], 'w') as f:
+  json.dump({'base_dir': src.as_posix(), 'files': files}, f)
+ET.ElementTree(ET.Element('grit-part')).write(argv[3], encoding='utf-8',
+                                              xml_declaration=True)
