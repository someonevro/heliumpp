+void NewTabPageHandler::GetSleepingTabs(GetSleepingTabsCallback callback) {
+  int count = 0;
+  int64_t bytes = 0;
+  for (BrowserWindowInterface* window : GetAllBrowserWindowInterfaces()) {
+    if (window->GetProfile() != profile_) {
+      continue;
+    }
+    TabStripModel* tabs = window->GetTabStripModel();
+    for (int i = 0; i < tabs->count(); ++i) {
+      tabs::TabInterface* tab = tabs->GetTabAtIndex(i);
+      if (!tab->GetContents()->WasDiscarded()) {
+        continue;
+      }
+      ++count;
+      // The last measurement before the tab went to sleep (also what its hover
+      // card reports as "memory freed").
+      if (auto* usage = TabResourceUsageTabHelper::From(tab)) {
+        bytes += usage->GetMemoryUsage().InBytes();
+      }
+    }
+  }
+  std::move(callback).Run(count, bytes);
+}
+
 void NewTabPageHandler::GetPrivacyMode(GetPrivacyModeCallback callback) {
   std::move(callback).Run(helium_privacy_mode::GetModeName(profile_));
 }
