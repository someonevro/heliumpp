+bool HeliumSidebarWebView::IsPositionInWindowCaption(
+    const gfx::Point& point) const {
+  // Page pixels are DIPs here: the page is not zoomed.
+  if (!caption_row_.Contains(point)) {
+    return false;
+  }
+  for (const gfx::Rect& button : caption_buttons_) {
+    if (button.Contains(point)) {
+      return false;
+    }
+  }
+  // The native address bar lies over the page; it is never title bar.
+  return !(address_bar_ && address_bar_->GetVisible() &&
+           address_bar_->bounds().Contains(point));
+}
