+void SidebarPageHandler::SetCaptionRegion(
+    mojom::RectPtr row,
+    std::vector<mojom::RectPtr> buttons) {
+  // Page input: sane sizes only, and a handful of buttons; anything else is
+  // dropped (the row then stops dragging until the next valid report).
+  constexpr int32_t kMax = 10000;
+  constexpr size_t kMaxButtons = 32;
+  const auto valid = [](const mojom::RectPtr& r) {
+    return r && r->x >= 0 && r->y >= 0 && r->width >= 0 && r->height >= 0 &&
+           r->x <= kMax && r->y <= kMax && r->width <= kMax &&
+           r->height <= kMax;
+  };
+  if (!valid(row) || buttons.size() > kMaxButtons) {
+    on_caption_region_.Run(gfx::Rect(), {});
+    return;
+  }
+  std::vector<gfx::Rect> holes;
+  for (const auto& b : buttons) {
+    if (!valid(b)) {
+      on_caption_region_.Run(gfx::Rect(), {});
+      return;
+    }
+    holes.emplace_back(b->x, b->y, b->width, b->height);
+  }
+  on_caption_region_.Run(gfx::Rect(row->x, row->y, row->width, row->height),
+                         holes);
+}
