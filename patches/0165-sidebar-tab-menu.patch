+void SidebarPageHandler::ShowTabMenu(const std::string& tab_id,
+                                     int32_t x,
+                                     int32_t y) {
+  // Page input: only a tab of this window, at a point inside a sane range.
+  int32_t id = 0;
+  if (!base::StringToInt(tab_id, &id) || x < 0 || y < 0 || x > 10000 ||
+      y > 10000) {
+    return;
+  }
+  for (tabs::TabInterface* tab : browser_->GetAllTabInterfaces()) {
+    if (tab->GetHandle().raw_value() == id) {
+      on_tab_menu_.Run(id, gfx::Point(x, y));
+      return;
+    }
+  }
+}
