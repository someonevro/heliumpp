+void HeliumSidebarWebView::OnTabMenu(int32_t tab_id, const gfx::Point& point) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  tabs::TabInterface* tab = nullptr;
+  for (tabs::TabInterface* t : browser_->GetAllTabInterfaces()) {
+    if (t->GetHandle().raw_value() == tab_id) {
+      tab = t;
+    }
+  }
+  if (!tab || !GetWidget()) {
+    return;
+  }
+  const int index = model->GetIndexOfTab(tab);
+  if (index == TabStripModel::kNoTab) {
+    return;
+  }
+  // Page pixels are DIPs here: the page is not zoomed.
+  gfx::Point screen_point = point;
+  views::View::ConvertPointToScreen(this, &screen_point);
+  tab_menu_ =
+      std::make_unique<TabContextMenuController>(tab->GetHandle(), this);
+  auto menu = std::make_unique<TabMenuModel>(
+      tab_menu_.get(), TabMenuModelDelegate::From(browser_), model, index);
+  TabMenuModel* menu_ptr = menu.get();
+  tab_menu_->LoadModel(std::move(menu), menu_ptr);
+  tab_menu_->RunMenuAt(screen_point, ui::mojom::MenuSourceType::kMouse,
+                       GetWidget());
+}
+
+bool HeliumSidebarWebView::IsContextMenuCommandChecked(
+    TabStripModel::ContextMenuCommand command_id) {
+  return false;
+}
+
+bool HeliumSidebarWebView::IsContextMenuCommandEnabled(
+    tabs::TabInterface* tab,
+    TabStripModel::ContextMenuCommand command_id) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  const int index = model->GetIndexOfTab(tab);
+  return index != TabStripModel::kNoTab &&
+         model->IsContextMenuCommandEnabled(index, command_id);
+}
+
+bool HeliumSidebarWebView::IsContextMenuCommandAlerted(
+    TabStripModel::ContextMenuCommand command_id) {
+  return false;
+}
+
+void HeliumSidebarWebView::ExecuteContextMenuCommand(
+    tabs::TabInterface* tab,
+    TabStripModel::ContextMenuCommand command_id,
+    int event_flags) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  const int index = model->GetIndexOfTab(tab);
+  if (index != TabStripModel::kNoTab) {
+    model->ExecuteContextMenuCommand(index, command_id);
+  }
+}
+
+bool HeliumSidebarWebView::GetContextMenuAccelerator(
+    int command_id,
+    ui::Accelerator* accelerator) {
+  int browser_cmd;
+  return GetWidget() &&
+         TabStripModel::ContextMenuCommandToBrowserCommand(command_id,
+                                                           &browser_cmd) &&
+         GetWidget()->GetAccelerator(browser_cmd, accelerator);
+}
